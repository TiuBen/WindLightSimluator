<Window x:Class="WindLightSimluator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindLightSimluator"
        mc:Ignorable="d"
        xmlns:comp="clr-namespace:WindLightSimluator.Components"
        xmlns:base="clr-namespace:WindLightSimluator.Components.Base"
        d:Width="1920" d:Height="1080"
        Width="1920" Height="1080"
        Title="MainWindow" >
    <Window.Resources>
        <Style TargetType="FrameworkElement" >
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style x:Key="ActiveGridStyle" TargetType="Grid">
            <!-- 默认背景（未激活） -->
            <Setter Property="Background" Value="{StaticResource MainContainerBg}"/>
            <Style.Triggers>
                <Trigger
                        Property="base:StateBehavior.IsActive"
                        Value="True">
                    <Setter Property="Background" Value="#f7f7f7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        
        <Style x:Key="RunwayStatusStyle" TargetType="comp:RunwayStatus">
            <!-- 默认背景（未激活） -->
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>

        <Style x:Key="WindPanelStyle" TargetType="comp:WindPanel">
            <!-- 默认背景（未激活） -->
            <Setter Property="Margin" Value="0 0 0 2"/>
            <Setter Property="WindPanelBackground" Value="{DynamicResource WindPanelBg.InActive}"/>
            <Setter Property="WindPanelTextColor" Value="{DynamicResource WindPanelTextColor.InActive}" />
            <Style.Triggers>
                <Trigger
                     Property="base:StateBehavior.IsActive"
                     Value="True">
                    <Setter Property="WindPanelBackground" Value="{DynamicResource WindPanelBg.Active}"/>
                    <Setter Property="WindPanelTextColor" Value="{DynamicResource WindPanelTextColor.Active}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="HeadCrossWindStyle" TargetType="comp:HeadCrossWind">
            <!-- 默认背景（未激活） -->
            <Setter Property="Margin" Value="0 0 0 2"/>
            <Setter Property="ContainerBackgroundColor" Value="{DynamicResource HeadCrossWind.ContainerBackgroundColor.Inactive}"/>
            <Setter Property="LabelBackgroundColor" Value="{DynamicResource HeadCrossWind.LabelBackgroundColor.Inactive}"/>
            <Setter Property="LabelTextColor" Value="{DynamicResource HeadCrossWind.LabelTextColor.Inactive}"/>
            <Setter Property="ValueTextBackgroundColor" Value="{DynamicResource HeadCrossWind.ValueTextBackgroundColor.Inactive}"/>
            <Setter Property="ValueTextColor" Value="{DynamicResource HeadCrossWind.ValueTextColor.Inactive}"/>
            <!-- 背景（激活） -->
            <Style.Triggers>
                <Trigger
                          Property="base:StateBehavior.IsActive"
                          Value="True">
                    <Setter Property="ContainerBackgroundColor" Value="{DynamicResource HeadCrossWind.ContainerBackgroundColor.Active}"/>
                    <Setter Property="LabelBackgroundColor" Value="{DynamicResource HeadCrossWind.LabelBackgroundColor.Active}"/>
                    <Setter Property="LabelTextColor" Value="{DynamicResource HeadCrossWind.LabelTextColor.Active}"/>
                    <Setter Property="ValueTextBackgroundColor" Value="{DynamicResource HeadCrossWind.ValueTextBackgroundColor.Active}"/>
                    <Setter Property="ValueTextColor" Value="{DynamicResource HeadCrossWind.ValueTextColor.Active}"/>

                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="RvrVisStyle" TargetType="comp:RvrVis">
            <!-- 默认背景（未激活） -->
            <Setter Property="Margin" Value="0 0 0 4"/>
            <Setter Property="ContainerBackgroundColor" Value="{DynamicResource HeadCrossWind.ContainerBackgroundColor.Inactive}"/>
            <Setter Property="LabelBackgroundColor" Value="{DynamicResource HeadCrossWind.LabelBackgroundColor.Inactive}"/>
            <Setter Property="LabelTextColor" Value="{DynamicResource HeadCrossWind.LabelTextColor.Inactive}"/>
            <Setter Property="ValueTextBackgroundColor" Value="{DynamicResource HeadCrossWind.ValueTextBackgroundColor.Inactive}"/>
            <Setter Property="ValueTextColor" Value="{DynamicResource HeadCrossWind.ValueTextColor.Inactive}"/>
            <!-- 背景（激活） -->
            <Style.Triggers>
                <Trigger
                    Property="base:StateBehavior.IsActive"
                    Value="True">
                    <Setter Property="ContainerBackgroundColor" Value="{DynamicResource HeadCrossWind.ContainerBackgroundColor.Active}"/>
                    <Setter Property="LabelBackgroundColor" Value="{DynamicResource HeadCrossWind.LabelBackgroundColor.Active}"/>
                    <Setter Property="LabelTextColor" Value="{DynamicResource HeadCrossWind.LabelTextColor.Active}"/>
                    <Setter Property="ValueTextBackgroundColor" Value="{DynamicResource HeadCrossWind.ValueTextBackgroundColor.Active}"/>
                    <Setter Property="ValueTextColor" Value="{DynamicResource HeadCrossWind.ValueTextColor.Active}"/>

                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="WeatherConditionStyle" TargetType="comp:WeatherCondition">
            <!-- 默认背景（未激活） -->
            <Setter Property="Margin" Value="0 0 0 4"/>
            <Setter Property="ContainerBackgroundColor" Value="{DynamicResource HeadCrossWind.ContainerBackgroundColor.Inactive}"/>
            <Setter Property="LabelBackgroundColor" Value="{DynamicResource HeadCrossWind.LabelBackgroundColor.Inactive}"/>
            <Setter Property="LabelTextColor" Value="{DynamicResource HeadCrossWind.LabelTextColor.Inactive}"/>
            <Setter Property="ValueTextBackgroundColor" Value="{DynamicResource HeadCrossWind.ValueTextBackgroundColor.Inactive}"/>
            <Setter Property="ValueTextColor" Value="{DynamicResource HeadCrossWind.ValueTextColor.Inactive}"/>
            <!-- 背景（激活） -->
            <Style.Triggers>
                <Trigger
              Property="base:StateBehavior.IsActive"
              Value="True">
                    <Setter Property="ContainerBackgroundColor" Value="{DynamicResource HeadCrossWind.ContainerBackgroundColor.Active}"/>
                    <Setter Property="LabelBackgroundColor" Value="{DynamicResource HeadCrossWind.LabelBackgroundColor.Active}"/>
                    <Setter Property="LabelTextColor" Value="{DynamicResource HeadCrossWind.LabelTextColor.Active}"/>
                    <Setter Property="ValueTextBackgroundColor" Value="{DynamicResource HeadCrossWind.ValueTextBackgroundColor.Active}"/>
                    <Setter Property="ValueTextColor" Value="{DynamicResource HeadCrossWind.ValueTextColor.Active}"/>

                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>


        <TabControl>
            <TabItem Header="气象自观模拟">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" MinHeight="90" />
                        <RowDefinition Height="11*" />
                    </Grid.RowDefinitions>
                    <comp:TopBar Grid.Row="0"  />
                    <Grid  Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Background="{DynamicResource MainBarBg}">

                            <Border CornerRadius="10" Width="60" Height="60" Margin="2">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFBCD5EC" Offset="0.005"/>
                                        <GradientStop Color="#FFEBF9FD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
                                    <TextBlock Text="圆角示例" />

                                    <TextBlock Text="圆角示例" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="10" Width="60" Height="60" Margin="2">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFBCD5EC" Offset="0.005"/>
                                        <GradientStop Color="#FFEBF9FD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
                                    <TextBlock Text="圆角示例" />

                                    <TextBlock Text="圆角示例" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="10" Width="60" Height="60" Margin="2">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFBCD5EC" Offset="0.005"/>
                                        <GradientStop Color="#FFEBF9FD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
                                    <TextBlock Text="圆角示例" />

                                    <TextBlock Text="圆角示例" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="10" Width="60" Height="60" Margin="2">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFBCD5EC" Offset="0.005"/>
                                        <GradientStop Color="#FFEBF9FD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
                                    <TextBlock Text="圆角示例" />

                                    <TextBlock Text="圆角示例" />
                                </StackPanel>
                            </Border>
                            <Button Content="换色" x:Name="SwitchThemeButtton" Click="SwitchThemeButtton_Click"/>
                        </StackPanel>
                        <Grid Grid.Column="1"  Margin="4"  >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="6*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid  Background="{StaticResource MainContainerBg}" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!--第一列-->
                                <Grid base:StateBehavior.IsActive="True" x:Name="Col1" MouseDown="Grid_MouseDown" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="3*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <comp:RunwayStatus   Grid.Row="0" RunwayNumber="01L" RunwayState="InUse" Style="{StaticResource RunwayStatusStyle}" IsActive="{Binding}" />
                                    <comp:WindPanel  Grid.Row="1" Grid.RowSpan="3"   Style="{StaticResource WindPanelStyle}" IsActive="{Binding}"/>
                                    <comp:HeadCrossWind Grid.Row="4" Grid.Column="0" HeadWindAVG2Text="-6.5" CrossWindAVG2Text="3.7"   Style="{StaticResource HeadCrossWindStyle}" IsActive="{Binding}"/>
                                    <comp:RvrVis RvrValue="800" VisValue="1000" Grid.Row="5"   Style="{StaticResource RvrVisStyle}" IsActive="{Binding}"/>
                                    <comp:WeatherCondition Grid.Row="6" Grid.Column="0"  Style="{StaticResource WeatherConditionStyle}" IsActive="{Binding}"/>

                                </Grid>
                                <!--第二列-->
                                <Grid base:StateBehavior.IsActive="False" Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="3*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <comp:RunwayStatus   RunwayNumber="MD1" RunwayState="Empty" Style="{StaticResource RunwayStatusStyle}"  />
                                    <comp:WindPanel  Grid.Row="1"  Grid.RowSpan="2" IsActive="{Binding}"  Style="{StaticResource WindPanelStyle}"/>
                                    <comp:HeadCrossWind  Grid.Row="3" HeadWindAVG2Text="-6.5" CrossWindAVG2Text="3.7"  Style="{StaticResource HeadCrossWindStyle}" IsActive="{Binding}"/>
                                    <comp:Qnh  Grid.Row="4" />
                                    <comp:RvrVis RvrValue="200" VisValue="3000" Grid.Row="5" Style="{StaticResource RvrVisStyle}" IsActive="{Binding}"/>
                                    <comp:Light Grid.Row="6" />

                                </Grid>
                                <!--第三列-->
                                <Grid base:StateBehavior.IsActive="False" x:Name="Col3"  Grid.Column="4" MouseDown="Grid_MouseDown">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="3*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <comp:RunwayStatus  Grid.Column="2" RunwayNumber="19R" RunwayState="NotInUse" Style="{StaticResource RunwayStatusStyle}" />
                                    <comp:WindPanel  Grid.Row="1"  Grid.RowSpan="3" IsActive="{Binding}"  Style="{StaticResource WindPanelStyle}"/>
                                    <comp:HeadCrossWind  Grid.Row="4" Grid.Column="2" HeadWindAVG2Text="-6.5" CrossWindAVG2Text="+3.7" Style="{StaticResource HeadCrossWindStyle}" IsActive="{Binding}"/>
                                    <comp:RvrVis RvrValue="1500" VisValue="3000" Grid.Row="5" Grid.Column="2" Style="{StaticResource RvrVisStyle}" IsActive="{Binding}"/>
                                    <comp:WeatherCondition Grid.Row="6" Grid.Column="2" Style="{StaticResource WeatherConditionStyle}" IsActive="{Binding}"/>

                                </Grid>

                            </Grid>
                            <comp:Metar Grid.Row="7"  Grid.ColumnSpan="3"/>
                        </Grid>






                    </Grid>

                </Grid>


            </TabItem>

            <TabItem Header="灯光ADB系统模拟">
                <StackPanel Margin="10">
                    <TextBlock Text="设置页面" FontSize="20"/>
                    <Button Content="保存" Width="100" Margin="5"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="RVR旋钮模拟">
                <TextBlock Text="版本 1.0" Margin="10"/>
            </TabItem>
            <TabItem Header="关于">
                <TextBlock Text="版本 1.0" Margin="10"/>
            </TabItem>
        </TabControl>


    </Grid>

</Window>


<!--Style="{StaticResource ActiveGridStyle}"--> 