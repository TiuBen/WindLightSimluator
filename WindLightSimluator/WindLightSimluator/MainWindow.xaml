<Window x:Class="WindLightSimluator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:comp="clr-namespace:WindLightSimluator.Views.Components"
        xmlns:Awos="clr-namespace:WindLightSimluator.Views.AWOS"
        xmlns:base="clr-namespace:WindLightSimluator.Views.Components.Base"
        xmlns:vm="clr-namespace:WindLightSimluator.ViewModels"
        xmlns:view="clr-namespace:WindLightSimluator.Views"
        xmlns:ADB="clr-namespace:WindLightSimluator.Views.Lights"
        xmlns:RVR="clr-namespace:WindLightSimluator.Views.RVRSwitch"
        d:Width="1920" d:Height="1080"
        Width="1920" Height="1080"
        Title="MainWindow" >
    <Window.Resources>
        <Style TargetType="FrameworkElement" >
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="气象自观模拟"  IsSelected="True">
                <Awos:Awos DataContext="{Binding AwosVM}"/>
            </TabItem>
            <TabItem Header="灯光ADB系统模拟" >
                <ADB:LightsSetting />
            </TabItem>
            <TabItem Header="RVR旋钮模拟">
                <RVR:RVRSwitch  />
            </TabItem>
         
            <TabItem Header="气象数据编辑器" >
                <view:WeatherEditor />
            </TabItem>
            <TabItem Header="关于">
                <TextBlock Text="版本 1.0" Margin="10"/>
            </TabItem>
        </TabControl>


    </Grid>

</Window>

