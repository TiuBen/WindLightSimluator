<UserControl x:Class="WindLightSimluator.Components.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Components"
             xmlns:base="clr-namespace:WindLightSimluator.Components.Base"
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             mc:Ignorable="d" 
             >
    <UserControl.Resources>
        <!--字体大小-->
        <conv:HeightToFontSizeConverter x:Key="HeightToFontSizeConverter"/>
      
        <Style x:Key="LabelStyle" TargetType="TextBlock" >
            <Setter Property="Foreground" Value="{StaticResource TopBarLabelTextColor}"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Margin" Value="10 0 10 0"/>
        </Style>
        <Style x:Key="TextStyle" TargetType="TextBlock" >
            <Setter Property="Foreground" Value="{StaticResource TopBarTextColor}"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="10 0 10 0"/>

            <!--<Setter Property="FontSize"  Value="{Binding ActualHeight,
                        RelativeSource={RelativeSource AncestorType=Border},
                        Converter={StaticResource  HeightToFontSizeConverter} , ConverterParameter=0.5 }"/>-->
        </Style>
        <Style TargetType="base:CapsuleBorder" >
            <Setter Property="Background"  Value="{StaticResource TopBarLabelBg}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource TopBarBg}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition  Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*" />
            <ColumnDefinition  Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition  Width="auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="OBMAN" Style="{StaticResource TextStyle}"  >
            <TextBlock.FontSize>
                <Binding    Path="ActualHeight"
                    RelativeSource="{RelativeSource AncestorType=Grid}"
                    Converter="{StaticResource HeightToFontSizeConverter}"
                    ConverterParameter="0.5" />
            </TextBlock.FontSize>
        </TextBlock>


        <!-- 磁差 -->
        <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <base:CapsuleBorder Grid.Row="0" Background="{StaticResource TopBarLabelBg}"
                       BorderBrush="Transparent"
                       BorderThickness="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       >
                <TextBlock Text="Declination" Style="{StaticResource LabelStyle}"  >
                    <TextBlock.FontSize>
                        <Binding    Path="ActualHeight"
                                     RelativeSource="{RelativeSource AncestorType=base:CapsuleBorder}"
                                     Converter="{StaticResource HeightToFontSizeConverter}"
                                     ConverterParameter="0.8" />
                    </TextBlock.FontSize>
                </TextBlock>
            </base:CapsuleBorder>
            <TextBlock  Grid.Row="1" Text="-4.49" Style="{StaticResource TextStyle}">
                <TextBlock.FontSize>
                    <Binding    Path="ActualHeight"
                                RelativeSource="{RelativeSource AncestorType=Grid}"
                                Converter="{StaticResource HeightToFontSizeConverter}"
                                ConverterParameter="0.45" />
                </TextBlock.FontSize>
            </TextBlock>
        </Grid>
        <!-- BJT -->
        <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <base:CapsuleBorder Grid.Row="0" >
                <TextBlock Text="BJT" Style="{StaticResource LabelStyle}"  >
                    <TextBlock.FontSize>
                        <Binding    Path="ActualHeight"
                            RelativeSource="{RelativeSource AncestorType=Grid}"
                            Converter="{StaticResource HeightToFontSizeConverter}"
                            ConverterParameter="0.8" />
                    </TextBlock.FontSize>
                </TextBlock>
            </base:CapsuleBorder>
            <TextBlock Grid.Column="1" Text="2025-12-07 17:13:50" Style="{StaticResource TextStyle}" />
        </Grid>
        <!-- UTC -->
        <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <base:CapsuleBorder Grid.Column="0">
                <TextBlock Text="UTC" FontSize="14" Style="{StaticResource LabelStyle}"/>
            </base:CapsuleBorder>
            <TextBlock Grid.Column="1" Text="2025-12-07 09:13:50" FontSize="18" FontWeight="Bold" Style="{StaticResource TextStyle}" />
        </Grid>

        <!-- sunrise / sunset -->
        <Grid Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- sunrise -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0">
                    <TextBlock Text="sunrise" Style="{StaticResource LabelStyle}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="2025-12-07 17:13:50" Style="{StaticResource TextStyle}" />
            </Grid>

            <!-- sunset -->
            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0">
                    <TextBlock Text="sunset" Style="{StaticResource LabelStyle}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="2025-12-07 17:13:50" Style="{StaticResource TextStyle}" />
            </Grid>
        </Grid>

        <!-- sunrise / sunset 右侧 -->
        <Grid Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0">
                <TextBlock Text="sunrise" Style="{StaticResource LabelStyle}"/>
            </Border>
            <Border Grid.Column="1">
                <TextBlock Text="sunset" Style="{StaticResource TextStyle}"/>
            </Border>
        </Grid>
    </Grid>

</UserControl>
