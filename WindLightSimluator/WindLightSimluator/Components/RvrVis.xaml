<UserControl x:Class="WindLightSimluator.Components.RvrVis"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Components"
             mc:Ignorable="d" 
             >
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontWeight" Value="DemiBold"/>

        </Style>
        <Style TargetType="Border">
            <Setter Property="Background" Value="White"/>
        </Style>

    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.Row="0"  Background="#FFDBDFE9" Margin="2,1" >
            <Label Content="RVR1A"/>
        </Border>

        <Border Grid.Column="0" Grid.Row="1" Background="#FFDBDFE9" Margin="2,1">
            <Label Content="VIS1A"/>
        </Border>
        <Border Grid.Column="1" Grid.Row="0" Margin="2,1" >
            <TextBlock Text="RVR1A"/>
        </Border>
        <Border Grid.Column="1" Grid.Row="1" Margin="2,1" >
            <TextBlock Text="VIS1A"/>
        </Border>
    </Grid>
</UserControl>
