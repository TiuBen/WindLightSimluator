<UserControl x:Class="WindLightSimluator.Components.WindSpeedGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             xmlns:base="clr-namespace:WindLightSimluator.Components.Base"
             mc:Ignorable="d"
             x:Name="root"
             d:DesignHeight="450" d:DesignWidth="800"  >

    <UserControl.Resources>
        <!-- 字体自动缩放，倍率 0.8，可改 -->
        <conv:WindSpeedFontSizeConverter x:Key="MainFontSize" Scale="0.6"/>
        <conv:WindSpeedFontSizeConverter x:Key="SubFontSize" Scale="0.2"/>
        <conv:WindSpeedFontSizeConverter x:Key="AutoFont2" Scale="0.45"/>
        <conv:WindSpeedFontSizeConverter x:Key="AutoFont3" Scale="0.25"/>
        <conv:WindSpeedFontSizeConverter x:Key="TextInGrid" Scale="0.4"/>

        <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" >
                <Setter.Value>
                    <Binding Path="ActualHeight"
                         RelativeSource="{RelativeSource AncestorType=Grid}"
                         Converter="{StaticResource TextInGrid}" />
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <!--<Setter Property="Margin" Value="0" />-->
            <!--<Setter Property="Foreground" Value="#7b83a5" />-->
            <Setter Property="Foreground" Value="#7b83a5" />
            <!--<Setter Property="Background" Value="#FFDBDFE9" />-->
            <Setter Property="Background" Value="Transparent" />
            <!--<Setter Property="Margin" Value="4 2 4 2"/>-->
        </Style>
        <!--<Style TargetType="Border">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>-->
        <!--<Style TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Gold" />

        </Style>-->
        <Style TargetType="base:BorderText">
            <!-- ★ 自动字体缩放（核心） -->
            <Setter Property="MainTextFontSize">
                <Setter.Value>
                    <Binding Path="ActualHeight"
                         RelativeSource="{RelativeSource AncestorType=Grid}"
                         Converter="{StaticResource MainFontSize}" />
                </Setter.Value>
            </Setter>
            <Setter Property="SubTextFontSize">
                <Setter.Value>
                    <Binding Path="ActualHeight"
                         RelativeSource="{RelativeSource AncestorType=Grid}"
                         Converter="{StaticResource SubFontSize}" />
                </Setter.Value>
            </Setter>
            <Setter Property="BackgroundColor"  Value="Transparent"/>
            <Setter Property="Margin" Value="1"/>
        </Style>

        <Style x:Key="GridMargin" TargetType="Grid">
            <Setter Property="Margin" Value="1"/>
        </Style>
        <Style x:Key="LabelGridDayBg" TargetType="Grid" BasedOn="{StaticResource GridMargin}">
            <Setter Property="Background" Value="#FFDBDFE9"/>
        </Style>
        <Style x:Key="LabelGridNightBg" TargetType="Grid">
            <Setter Property="Background" Value="Red"/>
        </Style>

    </UserControl.Resources>

    <!--<Grid Background="#FFDBDFE9">-->
    <!--在这里面 所有的深色 都 被 grid 包裹-->

    <base:CustomGrid Background="Transparent"   GridLineBrush="Transparent"  GridLineThickness="2" ShowGridLines="True">
        <base:CustomGrid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"  />
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </base:CustomGrid.ColumnDefinitions>
        <base:CustomGrid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </base:CustomGrid.RowDefinitions>

        <!-- ▬▬▬▬▬▬▬▬▬▬▬ 第一列 Label ▬▬▬▬▬▬▬▬▬▬▬ -->
        <Grid  Style="{StaticResource LabelGridDayBg}" Grid.Column="0" Grid.Row="0" />
        <Grid  Style="{StaticResource LabelGridDayBg}"  Grid.Column="0" Grid.Row="1"  >
            <TextBlock   Text="Head Wind"  Padding=" 9 6 9 6"/>
        </Grid>
        <Grid  Style="{StaticResource LabelGridDayBg}"   Grid.Column="0" Grid.Row="2"    >
            <TextBlock Text="Cross Wind" Padding=" 9 6 9 6"/>
        </Grid>

        <!-- ▬▬▬▬▬▬▬▬▬▬▬ 第2列 AVG2 ▬▬▬▬▬▬▬▬▬▬▬ -->
        <Grid  Style="{StaticResource LabelGridDayBg}"  Grid.Column="1" Grid.Row="0"  >
            <TextBlock  Text="AVG2"  Padding=" 0 0 0 0"  />
        </Grid>
        <Grid Grid.Column="1" Grid.Row="1" >
            <base:BorderText 
                         MainText="{Binding HeadWindAVG2Text, ElementName=root}"
                         SubText="mps"  
                         BorderThicknessValue="2"
                         Margin="1"
                />
        </Grid>
        <Grid Grid.Column="1" Grid.Row="2" >
            <base:BorderText  
                       MainText="{Binding CrossWindAVG2Text, ElementName=root}"
                       SubText="mps"  
                       BorderThicknessValue="2"  />
        </Grid>

        <!-- ▬▬▬▬▬▬▬▬▬▬▬ 第3列 空白 ▬▬▬▬▬▬▬▬▬▬▬ -->
        <Grid Grid.Row="0" Grid.Column="2"  />
        <Grid Grid.Row="1" Grid.Column="2"  />
        <Grid Grid.Row="2" Grid.Column="2"   />


        <!--▬▬▬▬▬▬▬▬▬▬▬ 第4列 WD / WS ▬▬▬▬▬▬▬▬▬▬▬-->

        <Grid  Style="{StaticResource LabelGridDayBg}" Grid.Column="3" Grid.Row="0" />
        <Grid  Style="{StaticResource LabelGridDayBg}"  Grid.Column="3" Grid.Row="1"  >
            <TextBlock   Text="WD"  Padding=" 9 6 9 6"/>
        </Grid>
        <Grid  Style="{StaticResource LabelGridDayBg}"   Grid.Column="3" Grid.Row="2"    >
            <TextBlock Text="WS" Padding=" 9 6 9 6"/>
        </Grid>
       

        <!--▬▬▬▬▬▬▬▬▬▬▬ 第5列 MNM2  ▬▬▬▬▬▬▬▬▬▬▬-->
        <Grid  Style="{StaticResource LabelGridDayBg}"  Grid.Column="4" Grid.Row="0"  >
            <TextBlock   Text="MNM2"  Padding=" 9 6 9 6"/>
        </Grid>
        <Grid Grid.Column="4" Grid.Row="1" >
            <base:BorderText  
                       MainText="{Binding WD_NNM2Text, ElementName=root}"
                       SubText="mps"  
                       BorderThicknessValue="2"  />
        </Grid>
        <Grid Grid.Column="4" Grid.Row="2" >
            <base:BorderText  
                       MainText="{Binding WS_NNM2Text, ElementName=root}"
                       
                       SubText="mps"  
                       
                       BorderThicknessValue="2"  />
        </Grid>
        <!--▬▬▬▬▬▬▬▬▬▬▬ 第6列 AVG2  ▬▬▬▬▬▬▬▬▬▬▬-->
        <Grid  Style="{StaticResource LabelGridDayBg}"  Grid.Column="5" Grid.Row="0"  >
            <TextBlock   Text="AVG2"  Padding=" 9 6 9 6"/>
        </Grid>
        <Grid Grid.Column="5" Grid.Row="1" >
            <base:BorderText  
                       MainText="{Binding WD_AVG2Text, ElementName=root}"
                       
                       SubText="mps"  
                       
                       BorderThicknessValue="2"  />
        </Grid>
        <Grid Grid.Column="5" Grid.Row="2" >
            <base:BorderText  
                       MainText="{Binding WS_AVG2Text, ElementName=root}"
                       
                       SubText="mps"  
                       
                       BorderThicknessValue="2"  />
        </Grid>
        <!--▬▬▬▬▬▬▬▬▬▬▬ 第6列 MAX2  ▬▬▬▬▬▬▬▬▬▬▬-->
        <Grid  Style="{StaticResource LabelGridDayBg}"  Grid.Column="6" Grid.Row="0"  >
            <TextBlock   Text="MAX2"  Padding=" 9 2 9 6"/>
        </Grid>
        <Grid Grid.Column="6" Grid.Row="1"   >
            <base:BorderText  
                       MainText="{Binding WD_MAX2Text, ElementName=root}"
                       
                       SubText="mps"  
                       
                       BorderThicknessValue="2"  />
        </Grid>
        <Grid Grid.Column="6" Grid.Row="2" >
            <base:BorderText  
                       MainText="{Binding WS_MAX2Text, ElementName=root}"
                       SubText="mps"  
                       BorderThicknessValue="2"  
                       BackgroundColor="Transparent"
                />
        </Grid>


    </base:CustomGrid>
</UserControl>
