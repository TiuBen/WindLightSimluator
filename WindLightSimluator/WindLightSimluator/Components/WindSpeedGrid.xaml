<UserControl x:Class="WindLightSimluator.Components.WindSpeedGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Components"
             mc:Ignorable="d" 
              x:Name="root"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style TargetType="Border">
            <Setter Property="Background" Value="White"/>
        </Style>
                
    </UserControl.Resources>
    <Grid Background="#FFDBDFE9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Content="Head Wind" Grid.Column="0" Grid.Row="1"/>

        <Label Content="Cross Wind" Grid.Column="0" Grid.Row="2" />
        <Label Content="AVG2" Grid.Column="1" Grid.Row="0"  />


        <Border Grid.Column="1" Grid.Row="1">
            <TextBlock Text="{Binding HeadWindAVG2Text, ElementName=root}"  />
        </Border>
        <TextBlock Text="{Binding CrossWindAVG2Text, ElementName=root}" Grid.Column="1" Grid.Row="2" />

        <Label Content="WD" Grid.Column="3" Grid.Row="1" />
        <Label Content="WS" Grid.Column="3" Grid.Row="2" />
        <Label Content="MNM2" Grid.Column="4" Grid.Row="0"  />
        <Label Content="AVG2" Grid.Column="5" Grid.Row="0"  />
        <Label Content="MAX2" Grid.Column="6" Grid.Row="0"  />

        <TextBlock Text="{Binding WD_NNM2Text, ElementName=root}" Grid.Column="4" Grid.Row="1" />
        <TextBlock Text="{Binding WS_NNM2Text, ElementName=root}" Grid.Column="4" Grid.Row="2" />

        <TextBlock Text="{Binding WD_AVG2Text, ElementName=root}" Grid.Column="5" Grid.Row="1" />
        <TextBlock Text="{Binding WS_AVG2Text, ElementName=root}" Grid.Column="5" Grid.Row="2" />

        <TextBlock Text="{Binding WD_MAX2Text, ElementName=root}" Grid.Column="6" Grid.Row="1" />
        <TextBlock Text="{Binding WS_MAX2Text, ElementName=root}" Grid.Column="6" Grid.Row="2" />


    </Grid>
</UserControl>
