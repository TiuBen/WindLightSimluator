<UserControl x:Class="WindLightSimluator.Components.Light"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Components"
             mc:Ignorable="d" 
             xmlns:base="clr-namespace:WindLightSimluator.Components.Base"
            >
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontWeight" Value="DemiBold"/>

        </Style>
        <Style TargetType="base:BorderText">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="BorderColor" Value="White"/>
        </Style>
    </UserControl.Resources>
    <UniformGrid Columns="3" Background="#c8e2f7">
        <Border BorderThickness="2" BorderBrush="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label  Grid.Row="0" Content="light" FontSize="28" />
                <base:BorderText Grid.Row="1" MainText="///" />
                <base:BorderText Grid.Row="2" MainText="///" SubText="%"/>
            </Grid>
        </Border>
        <Border Grid.Column="1" BorderThickness="2" BorderBrush="White">
            <Grid  Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="MANUAL PV"   Grid.Row="0"/>
                <Label Content="MANUAL PW"  Grid.Row="1"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" BorderThickness="2" BorderBrush="White">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <base:BorderText  MainText="///" SubText="m" BackgroundColor="White"/>
                <base:BorderText Grid.Row="1" MainText="///" />
            </Grid>
        </Border>

    </UniformGrid>


</UserControl>
