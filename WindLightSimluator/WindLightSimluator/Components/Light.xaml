<UserControl x:Class="WindLightSimluator.Components.Light"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             xmlns:local="clr-namespace:WindLightSimluator.Components"
             xmlns:base="clr-namespace:WindLightSimluator.Components.Base"
             mc:Ignorable="d" 
            >
    <UserControl.Resources>
        <!--主题颜色+是否被选中-->
        <conv:ThemeActiveColorConverter x:Key="ThemeActiveColorConverter"/>
        <conv:HeightToFontSizeConverter x:Key="HeightToFontSizeConverter"/>

        <Style TargetType="Border" >
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource QnhLabelBg}"/>
        </Style>
        <!--字体大小-->
        <Style TargetType="TextBlock" >
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10 0 10 0"/>
            <Setter Property="Background" Value="{DynamicResource QnhLabelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource QnhLabelTextColor}"/>
            <Setter Property="FontSize"  Value="{Binding ActualHeight,
               RelativeSource={RelativeSource AncestorType=Border},
              Converter={StaticResource  HeightToFontSizeConverter}, 
              ConverterParameter=0.5}"/>
        </Style>
        <Style TargetType="base:BorderText" >
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThicknessValue" Value="2"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
           
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border  Grid.Row="0" Grid.RowSpan="2"  >
            <TextBlock Text="light"/>
        </Border>
        <base:BorderText Grid.Row="2" Grid.RowSpan="2" MainText="///" />
        <base:BorderText Grid.Row="4"  Grid.RowSpan="2" MainText="///" SubText="%"/>

        <Border  Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" >
            <TextBlock Text="MANUAL PV"/>
        </Border>
        <Border  Grid.Row="3" Grid.RowSpan="3" Grid.Column="1" >
            <TextBlock Text="MANUAL PW"/>
        </Border>

        <base:BorderText  Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"  MainText="///" SubText="m"/>
        <base:BorderText  Grid.Row="3" Grid.RowSpan="3" Grid.Column="2" MainText="///" SubText="m" />



    </Grid>


</UserControl>
