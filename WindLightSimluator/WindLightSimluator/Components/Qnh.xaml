<UserControl x:Class="WindLightSimluator.Components.Qnh"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Components"
             xmlns:base="clr-namespace:WindLightSimluator.Components.Base"
             mc:Ignorable="d" 
             d:Width="300"
            >
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="60"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Arial Black"/>
            <Setter Property="FontSize" Value="60"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <!-- 定义高度到字体大小的转换器 -->
        <local:HeightToFontSizeConverter x:Key="HeightToFontSizeConverter"/>
    </UserControl.Resources>
    <Grid Name="MainGrid" Background="Aqua">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
            <TextBlock Text="QNH"    HorizontalAlignment="Center" VerticalAlignment="Center"  
                       FontSize="{Binding ElementName=MainGrid, Path=ActualHeight, Converter={StaticResource  HeightToFontSizeConverter}, ConverterParameter=0.8}"/>
        <base:BorderText Grid.Column="1" 
                         MainText="1032.5" 
                         Margin="0"
                         MainTextFontSize="{Binding ElementName=MainGrid, Path=ActualHeight, Converter={StaticResource HeightToFontSizeConverter}, ConverterParameter=0.8}" 
                         SubText="hPa" />
    </Grid>
</UserControl>
