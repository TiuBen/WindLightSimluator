<UserControl x:Class="WindLightSimluator.Components.Qnh"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Components"
             xmlns:base="clr-namespace:WindLightSimluator.Components.Base"
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             mc:Ignorable="d" 
             d:Width="300"
            >
    <UserControl.Resources>
        <!-- 定义高度到字体大小的转换器 -->
        <conv:HeightToFontSizeConverter x:Key="HeightToFontSizeConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="60"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"  Value="{Binding ActualHeight,
                    RelativeSource={RelativeSource AncestorType=Border},
                    Converter={StaticResource  HeightToFontSizeConverter}, 
                    ConverterParameter=0.6}"/>
        </Style>
        <!--<Style TargetType="base:BorderText">
            <Setter Property="MainTextFontSize"  Value="{Binding ActualHeight,
             RelativeSource={RelativeSource AncestorType=Grid},
             Converter={StaticResource  HeightToFontSizeConverter}, 
             ConverterParameter=0.2}"/>
        </Style>-->



    </UserControl.Resources>
    <Grid Name="MainGrid" Background="{DynamicResource QnhMainBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource QnhLabelBg}">
            <TextBlock Text="QNH"   
                       Foreground="{DynamicResource QnhLabelTextColor}"/>
        </Border>
        <base:BorderText Grid.Column="1" 
                         MainText="1032.5" 
                         Margin="0"
                         SubText="hPa" 
                         BackgroundColor="{DynamicResource QnhNumberBg}"
                         MainTextColor="{DynamicResource QnhNumberTextColor}"
                         BorderColor="{DynamicResource QnhNumberBg}"
                         SubTextColor="{DynamicResource QnhNumberTextColor}"
                         />
    </Grid>
</UserControl>

