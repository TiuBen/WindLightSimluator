<UserControl x:Class="WindLightSimluator.Components.Qnh"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Components"
             xmlns:base="clr-namespace:WindLightSimluator.Components.Base"
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             mc:Ignorable="d" 
             d:Width="300"
            >
    <UserControl.Resources>
        <!-- 定义高度到字体大小的转换器 -->
        <conv:HeightToFontSizeConverter x:Key="HeightToFontSizeConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="60"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"  Value="{Binding ActualHeight,
                    RelativeSource={RelativeSource AncestorType=Border},
                    Converter={StaticResource  HeightToFontSizeConverter}, 
                    ConverterParameter=0.6}"/>
        </Style>

    </UserControl.Resources>
    <Grid Background="{StaticResource QnhLight.ContainerBackgroundColor}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource QnhLight.LabelBackgroundColor}">
            <TextBlock Text="QNH"   
                       Foreground="{StaticResource QnhLight.LabelTextColor}"/>
        </Border>
        <base:BorderText Grid.Column="1" 
                         MainText="1032.5" 
                         Margin="0"
                         SubText="hPa  " 
                         BackgroundColor="Transparent"
                         BorderColor="{DynamicResource QnhNumberBg}"
                         MainTextColor="{DynamicResource QnhLight.ValueTextColor}"
                         SubTextColor="{DynamicResource QnhLight.ValueTextColor}"
                         />
    </Grid>
</UserControl>

