<UserControl x:Class="WindLightSimluator.Components.WeatherCondition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Components"
             xmlns:base="clr-namespace:WindLightSimluator.Components.Base"
             mc:Ignorable="d" 
            >
    <UserControl.Resources>
        <!--<Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="28"/>
        </Style>-->
        <Style TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontWeight" Value="Normal"/>

        </Style>
        <Style TargetType="Border">
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="UniformGrid">
            <Setter Property="Background" Value="#FFDBDFE9"/>
        </Style>
        <Style TargetType="Grid">
            <Setter Property="Background" Value="#FFDBDFE9"/>
        </Style>
        <Style TargetType="base:BorderText">
            <!--<Setter Property="BackgroundColor" Value="#FFF1F2F6"/>-->
            <Setter Property="BackgroundColor" Value="Red"/>
            <Setter Property="BorderColor" Value="#FFF1F2F6"/>
            <Setter Property="MainTextFontSize" Value="16"/>
            
            <Setter Property="FontWeight" Value="DemiBold"/>

        </Style>
    </UserControl.Resources>

