<UserControl x:Class="WindLightSimluator.Components.WeatherCondition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Components"
             xmlns:base="clr-namespace:WindLightSimluator.Components.Base"
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             mc:Ignorable="d" 
            >
    <UserControl.Resources>
        <!--主题颜色+是否被选中-->
        <conv:ThemeActiveColorConverter x:Key="ThemeActiveColorConverter"/>
        <conv:HeightToFontSizeConverter x:Key="HeightToFontSizeConverter"/>
        <Style TargetType="Border" >
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource ThemeActiveColorConverter}" ConverterParameter="HeadCrossWindLableBg">
                        <Binding Path="(base:StateBehavior.IsActive)" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="Theme" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <!--字体大小-->
        <Style TargetType="TextBlock" >
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Padding" Value="10 0 10 0"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource ThemeActiveColorConverter}" ConverterParameter="HeadCrossWindLabelTextColor">
                        <Binding Path="(base:StateBehavior.IsActive)" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="Theme" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize"  Value="{Binding ActualHeight,
              RelativeSource={RelativeSource AncestorType=Border},
             Converter={StaticResource  HeightToFontSizeConverter}, 
             ConverterParameter=0.7}"/>
        </Style>
        <Style TargetType="base:BorderText" >
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThicknessValue" Value="2"/>
            <Setter Property="SubText" Value="mps"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="MainTextColor" >
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource ThemeActiveColorConverter}" ConverterParameter="HeadCrossWindNumberTextColor">
                        <Binding Path="(base:StateBehavior.IsActive)" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="Theme" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="SubTextColor" >
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource ThemeActiveColorConverter}" ConverterParameter="HeadCrossWindNumberTextColor">
                        <Binding Path="(base:StateBehavior.IsActive)" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="Theme" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>


        <Border   Grid.Row="0" Grid.Column="0" >
            <TextBlock Text="Cloud 1st layer"/>
        </Border>
        <base:BorderText MainText="///" SubText="m" Grid.Row="1" Grid.Column="0"/>
        <Border Grid.Row="2" Grid.Column="0">
            <TextBlock Text="T"/>
        </Border>
        <base:BorderText MainText="///" SubText="°C" Grid.Row="3" Grid.Column="0"/>

        <Border Grid.Row="0" Grid.Column="1">
            <TextBlock Text="    VVIS    "/>
        </Border>
        <base:BorderText MainText="///" SubText="m" Grid.Row="1" Grid.Column="1"/>
        <Border Grid.Row="2" Grid.Column="1">
            <TextBlock Text="DP"/>
        </Border>
        <base:BorderText MainText="///" SubText="°C" Grid.Row="3" Grid.Column="1"/>

        <Border Grid.Row="0" Grid.Column="2">
            <TextBlock Text="Rain 1h"/>
        </Border>
        <base:BorderText MainText="///" SubText="mm" Grid.Row="1" Grid.Column="2"/>
        <Border Grid.Row="2" Grid.Column="2">
            <TextBlock Text="RH"/>
        </Border>
        <base:BorderText MainText="///" SubText="%" Grid.Row="3" Grid.Column="2"/>

        <Border Grid.Row="0" Grid.Column="3">
            <TextBlock Text="Rain 24h"/>
        </Border>
        <base:BorderText MainText="///" SubText="mm" Grid.Row="1" Grid.Column="3"/>
        <Border Grid.Row="2" Grid.Column="3">
            <TextBlock Text="QFE"/>
        </Border>
        <base:BorderText MainText="///" SubText="%" Grid.Row="3" Grid.Column="3"/>

        <Border Grid.Row="0" Grid.Column="4">
            <TextBlock Text="STEMP"/>
        </Border>
        <base:BorderText MainText="///" SubText="m" Grid.Row="1" Grid.Column="4"/>
        <Border Grid.Row="2" Grid.Column="4">
            <TextBlock Text="STATUS"/>
        </Border>
        <base:BorderText MainText="///"  Grid.Row="3"  Grid.Column="4"/> 
    </Grid>



   
</UserControl>
