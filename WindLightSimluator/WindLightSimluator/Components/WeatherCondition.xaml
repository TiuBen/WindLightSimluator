    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>


        <Label Content="Cloud 1st layer"  Grid.Row="0" Grid.Column="0" />
        <base:BorderText MainText="///" SubText="m" Grid.Row="1"  Grid.Column="0"/>
        <Label Content="T" Grid.Row="2"  Grid.Column="0"/>
        <base:BorderText MainText="///" SubText="°C" Grid.Row="3"  Grid.Column="0"/>

        <Label Content="    VVIS    " Grid.Row="0"  Grid.Column="1"/>
        <base:BorderText MainText="///" SubText="m" Grid.Row="1"  Grid.Column="1" />
        <Label Content="DP" Grid.Row="2"  Grid.Column="1"/>
        <base:BorderText MainText="///" SubText="°C" Grid.Row="3"  Grid.Column="1"/>

        <Label Content="Rain 1h" Grid.Row="0"  Grid.Column="2"/>
        <base:BorderText MainText="///" SubText="mm" Grid.Row="1" Grid.Column="2"/>
        <Label Content="RH" Grid.Row="2"  Grid.Column="2"/>
        <base:BorderText MainText="///" SubText="%" Grid.Row="3"  Grid.Column="2"/>

        <Label Content="Rain 24h" Grid.Row="0"  Grid.Column="3"/>
        <base:BorderText MainText="///" SubText="mm" Grid.Row="1"  Grid.Column="3"/>
        <Label Content="QFE" Grid.Row="2" Grid.Column="3"/>
        <base:BorderText MainText="///" SubText="%" Grid.Row="3" Grid.Column="3"/>

        <Label Content="STEMP" Grid.Row="0" Grid.Column="4"/>
        <base:BorderText MainText="///" SubText="m" Grid.Row="1"  Grid.Column="4"/>
        <Label Content="STATUS" Grid.Row="2"  Grid.Column="4"/>
        <base:BorderText MainText="///"  Grid.Row="3"  Grid.Column="4"/>
    </Grid>



