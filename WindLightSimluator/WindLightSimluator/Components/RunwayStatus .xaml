<UserControl x:Class="WindLightSimluator.Components.RunwayStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Components"
             mc:Ignorable="d" 
            >
    <UserControl.Resources>
        <!-- converters 实例 -->
        <local:MultiplyConverter x:Key="Multiply2" Factor="2"/>
        <!-- Empty string -> Visibility.Collapsed -->
        <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
        <!-- Corner = ActualHeight / 2 -->

        <local:HalfConverter x:Key="Half"/>
    </UserControl.Resources>
    <UserControl.Height>
        <Binding Path="RunwayFontSize" RelativeSource="{RelativeSource Self}" Converter="{StaticResource Multiply2}"/>
    </UserControl.Height>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid>
            
        <!-- ===============================
             左边倒直角梯形（100%自适应）
             =============================== -->
        <Viewbox Stretch="Fill">
            <Canvas Width="100" Height="100">
                <!-- 标准化成 100x100 的比例路径 -->
                <Path Fill="#333" Stroke="Black" StrokeThickness="1">
                    <Path.Data>
                        <!-- 倒直角梯形：左边直角，右下是钝角 -->
                        <PathGeometry>
                            <PathFigure StartPoint="0,0">
                                <LineSegment Point="100,0"/>
                                <!-- 右上 -->
                                <LineSegment Point="80,100"/>
                                <!-- 右下（钝角位置） -->
                                <LineSegment Point="0,100"/>
                                <!-- 左下 -->
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Canvas>
        </Viewbox>

        <TextBlock Text="{Binding RunwayNumber}"
                       Foreground="White"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       IsHitTestVisible="False"
                       FontSize="{Binding RunwayFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Grid>

        <!-- 右侧：胶囊形状态条 -->
        <Grid Grid.Column="2" Margin="0,0,20,0">
            <!-- 我们把 Border 的高度绑定到 UserControl 的 Height（可以用 Padding 调整内缩） -->
            <Border x:Name="StatusBorder"
                    Background="#4A90E2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Padding="12,4"
                    SnapsToDevicePixels="True"
                    Visibility="{Binding StatusText,
                                     Converter={StaticResource EmptyToCollapsed}}"
                    >
                <!-- CornerRadius = ActualHeight/2 保证两端半圆 -->
                <Border.CornerRadius>
                    <MultiBinding Converter="{StaticResource Half}">
                        <!-- 取 Border 的 ActualHeight 作为输入 -->
                        <Binding ElementName="StatusBorder" Path="ActualHeight"/>
                    </MultiBinding>
                </Border.CornerRadius>

                <!-- 内容区：居中显示状态文字 -->
                <TextBlock Text="{Binding StatusText}"
                           Foreground="White"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{Binding RunwayFontSize, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Multiply2}, ConverterParameter=-0.6}"/>
                <!-- 说明：上面状态文字的 FontSize 我设置为 RunwayFontSize 的某个比例（可调），避免状态字太大 -->
            </Border>
        </Grid>

    </Grid>
</UserControl>
