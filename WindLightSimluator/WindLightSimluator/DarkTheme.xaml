<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <!--侧栏 包括整个 主界面-->
    <SolidColorBrush x:Key="MainBarBg"   Color="#002C5C"/>
    <!--顶端栏-->
    <SolidColorBrush x:Key="TopBarBg"   Color="#08204c"/>
    <SolidColorBrush x:Key="TopBarLabelBg"   Color="#3e9ae3"/>
    <SolidColorBrush x:Key="TopBarLabelTextColor"  Color="#fafafa"/>
    <SolidColorBrush x:Key="TopBarTextColor"   Color="#fafafa"/>
    <SolidColorBrush x:Key="MainContainerBg" Color="#080408"/>

    <!--RunwayStatus-->
    <SolidColorBrush x:Key="RunwayStatus.ContainerBackgroundColor.InActive" Color="#1F3B5F"/>
    <SolidColorBrush x:Key="RunwayStatus.ContainerBackgroundColor.Active" Color="#1F3B5F"/>

    <SolidColorBrush x:Key="RunwayStatus.LabelBackgroundColor.InActive" Color="#7b83a5"/>
    <SolidColorBrush x:Key="RunwayStatus.LabelBackgroundColor.Active" Color="#3e9ae3"/>
    
    <SolidColorBrush x:Key="RunwayStatus.LabelTextColor.InActive" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="RunwayStatus.LabelTextColor.Active" Color="#FAFAFA"/>

    <SolidColorBrush x:Key="RunwayStatus.ValueTextBackgroundColor.InActive" Color="#aab8db"/>
    <SolidColorBrush x:Key="RunwayStatus.ValueTextBackgroundColor.Active" Color="#EC7439"/>

    <SolidColorBrush x:Key="RunwayStatus.ValueTextColor.InActive" Color="#DCE0E9"/>
    <SolidColorBrush x:Key="RunwayStatus.ValueTextColor.Active" Color="#FAFAFA"/>
    
    <!--HeadCrossWind RrvVis WeatherCondition-->
    <SolidColorBrush x:Key="RvrVis.ContainerBackgroundColor.InActive" Color="#2c4c85"/>
    <SolidColorBrush x:Key="RvrVis.ContainerBackgroundColor.Active" Color="#2c4c85"/>

    <SolidColorBrush x:Key="RvrVis.LabelTextColor.InActive" Color="#7988b0"/>
    <SolidColorBrush x:Key="RvrVis.LabelTextColor.Active" Color="#fafafa"/>

    <SolidColorBrush x:Key="RvrVis.LabelBackgroundColor.InActive" Color="#213b6c"/>
    <SolidColorBrush x:Key="RvrVis.LabelBackgroundColor.Active" Color="#213b6c"/>

    <SolidColorBrush x:Key="RvrVis.ValueTextBackgroundColor.InActive" Color="#3FA8F4"/>
    <SolidColorBrush x:Key="RvrVis.ValueTextBackgroundColor.Active" Color="#3FA8F4"/>

    <SolidColorBrush x:Key="RvrVis.ValueTextColor.InActive" Color="#7988b0"/>
    <SolidColorBrush x:Key="RvrVis.ValueTextColor.Active" Color="#fafafa"/>

    <!--Qnh   Light   Metar-->
    <SolidColorBrush x:Key="QnhLight.ContainerBackgroundColor" Color="#2c4c85"/>
    <SolidColorBrush x:Key="QnhLight.LabelBackgroundColor" Color="#18305e"/>
    <SolidColorBrush x:Key="QnhLight.LabelTextColor" Color="#fafafa"/>
    <SolidColorBrush x:Key="QnhLight.ValueTextBackgroundColor" Color="#2c4c85"/>
    <SolidColorBrush x:Key="QnhLight.ValueTextColor" Color="#fafafa"/>



    <!--WindPanel-->
    <SolidColorBrush x:Key="WindPanel.ContainerBackgroundColor.Active"  Color="#2c4c85"/>
    <SolidColorBrush x:Key="WindPanel.ContainerBackgroundColor.InActive"  Color="#233b6b"/>

    <SolidColorBrush x:Key="WindPanel.OuterArcColor.JustAhead.Active" Color="#EC7439"/>
    <SolidColorBrush x:Key="WindPanel.OuterArcColor.JustAhead.InActive" Color="#ECB397"/>
    <SolidColorBrush x:Key="WindPanel.OuterArcColor.InRange.Active" Color="#0074ba"/>
    <SolidColorBrush x:Key="WindPanel.OuterArcColor.InRange.InActive" Color="#145797"/>
    <SolidColorBrush x:Key="WindPanel.OuterArcColor.OutRange.Active" Color="#4c6fa7"/>
    <SolidColorBrush x:Key="WindPanel.OuterArcColor.OutRange.InActive" Color="#395789"/>

    <SolidColorBrush x:Key="WindPanel.InnerArcColor.JustAhead.Active" Color="#f46d21"/>
    <SolidColorBrush x:Key="WindPanel.InnerArcColor.JustAhead.InActive" Color="#934f45"/>
    <SolidColorBrush x:Key="WindPanel.InnerArcColor.InRange.Active" Color="#57b4f8"/>
    <SolidColorBrush x:Key="WindPanel.InnerArcColor.InRange.InActive" Color="#3977b4"/>
    <SolidColorBrush x:Key="WindPanel.InnerArcColor.OutRange.Active" Color="#4c6fa7"/>
    <SolidColorBrush x:Key="WindPanel.InnerArcColor.OutRange.InActive" Color="#395789"/>

</ResourceDictionary>



