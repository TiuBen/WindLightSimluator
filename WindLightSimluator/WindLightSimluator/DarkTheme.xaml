<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    
      <!--顶端栏-->
    <SolidColorBrush x:Key="TopBarBg"   Color="#002C5C"/>
   <!--侧栏 包括整个 主界面-->
    <SolidColorBrush x:Key="MainBarBg"   Color="#002C5C"/>



    <!-- ===== 字体颜色 ===== -->
    <SolidColorBrush x:Key="PrimaryFontBrush"   Color="#FFFFFF"/>
    <!-- 主文字：白 -->
    <SolidColorBrush x:Key="SecondaryFontBrush" Color="#AFC8FF"/>
    <!-- 次文字：淡蓝 -->
    <SolidColorBrush x:Key="TertiaryFontBrush"  Color="#6F8EBB"/>
    <!-- 弱提示：暗蓝灰 -->
    <SolidColorBrush x:Key="DisabledFontBrush"  Color="#4A5B7A"/>

    <!-- ===== 背景色 ===== -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#001224"/>
    <!-- 整体屏幕深蓝 -->
    <SolidColorBrush x:Key="CardBackgroundBrush"    Color="#002C5C"/>
    <!-- 单个 runways block -->
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#003A6F"/>
    <!-- METAR 区 / 信息区 -->

    <!-- ===== 分割 / 边线 ===== -->
    <SolidColorBrush x:Key="BorderBrush"  Color="#1F3B5F"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#224873"/>

    <!-- ===== 强调色 ===== -->
    <SolidColorBrush x:Key="AccentBrush"   Color="#3FA8F4"/>
    <!-- 蓝色点击 / 高亮 -->
    <SolidColorBrush x:Key="WarningBrush"  Color="#FF8A38"/>
    <!-- 橙色 Landing/Takeoff -->
    <SolidColorBrush x:Key="HighlightBrush" Color="#3F8CFA"/>
    <!-- 按钮 hover  -->

</ResourceDictionary>
