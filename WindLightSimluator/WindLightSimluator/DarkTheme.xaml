<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    
   <!--侧栏 包括整个 主界面-->
    <SolidColorBrush x:Key="MainBarBg"   Color="#002C5C"/>
    <!--RunwayStatus-->
    <SolidColorBrush x:Key="RwyTextBg_InUse"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RwyCapsuleBg_InUse"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RwyTextColor_InUse"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RwyTextBg_NotInUse"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RwyCapsuleBg_NotInUse"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RwyTextColor_NotInUse"   Color="#FFFFFF"/>


    <!--Wind360-->
    <SolidColorBrush x:Key="Wind360PrimaryBg"   Color="#1760c7"/>
    <SolidColorBrush x:Key="Wind360SecondaryBg"   Color="#0047ab"/>

    

     <!--===== 字体颜色 =====--> 
    <SolidColorBrush x:Key="PrimaryFontBrush"   Color="#FFFFFF"/>
     <!--主文字：白--> 
    <SolidColorBrush x:Key="SecondaryFontBrush" Color="#AFC8FF"/>
     <!--次文字：淡蓝--> 
    <SolidColorBrush x:Key="TertiaryFontBrush"  Color="#6F8EBB"/>
     <!--弱提示：暗蓝灰--> 
    <SolidColorBrush x:Key="DisabledFontBrush"  Color="#4A5B7A"/>

     <!--===== 背景色 =====--> 
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#001224"/>
     <!--整体屏幕深蓝--> 
    <SolidColorBrush x:Key="CardBackgroundBrush"    Color="#002C5C"/>
     <!--单个 runways block--> 
    <!--<SolidColorBrush x:Key="SectionBackgroundBrush" Color="#003A6F"/>-->
     <!--METAR 区 / 信息区--> 

    <!-- ===== 分割 / 边线 ===== -->
    <SolidColorBrush x:Key="BorderBrush"  Color="#1F3B5F"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#224873"/>

    <!-- ===== 强调色 ===== -->
    <SolidColorBrush x:Key="AccentBrush"   Color="#3FA8F4"/>
    <!-- 蓝色点击 / 高亮 -->
    <SolidColorBrush x:Key="WarningBrush"  Color="#FF8A38"/>
    <!-- 橙色 Landing/Takeoff -->
    <SolidColorBrush x:Key="HighlightBrush" Color="#3F8CFA"/>
    <!-- 按钮 hover  -->

    <!-- 主背景 / 面板灰 -->
    <Color x:Key="Bg_Gray_Main">#A3A7B1</Color>
    <Color x:Key="Bg_Gray_Light">#DCE0E9</Color>
    <Color x:Key="Bg_Gray_Lighter">#F1F2F6</Color>
    <Color x:Key="Bg_Gray_Dark">#7F869C</Color>
    <Color x:Key="Bg_Gray_Dark1">#7b83a5</Color>
    <Color x:Key="Bg_Gray_Dark2">#7F869C</Color>
    <Color x:Key="Bg_Gray_Dark3">#aab8db</Color>
    <Color x:Key="Bg_Blue_Dark1">#1F3B5F</Color>
    <Color x:Key="Bg_Blue_Dark2">#2c4c85</Color>
    <Color x:Key="Bg_Blue_Dark3">#233b6b</Color>

    
    <!-- 纯白 / 高亮 -->
    <Color x:Key="White_Main">#FAFAFA</Color>
    <Color x:Key="White_Off">#F9FAFA</Color>

    <!-- 蓝色系（主界面核心色） -->
    <Color x:Key="Blue_DarkPrimary">#0061a7</Color>
    <Color x:Key="Blue_Primary">#3e9ae3</Color>
    <Color x:Key="Blue_Deep">#166096</Color>
    <Color x:Key="Blue_Mid">#5595CA</Color>
    <Color x:Key="Blue_Light">#AABBD9</Color>
    <Color x:Key="Blue_Lighter">#E0EEFD</Color>
    <Color x:Key="Blue_Lighter2">#b7d9ea</Color>
    <Color x:Key="Blue_Pale">#C8E3F8</Color>
    <Color x:Key="Blue_Alt1">#7CABD4</Color>
    <Color x:Key="Blue_Alt2">#5A75AB</Color>
    <Color x:Key="Blue_Alt3">#265bc6</Color>
    <Color x:Key="Blue_Alt4">#2c5ac1</Color>
    <Color x:Key="Blue_Alt5">#1d47a2</Color>
    
    <!-- 深色文字 / 刻度 -->
    <Color x:Key="Text_Darker">#080408</Color>
    <Color x:Key="Text_Muted">#525B58</Color>

    <!-- 橙色 / 警示 / 风向箭头 -->
    <Color x:Key="Orange_Alert">#EC7439</Color>
    <Color x:Key="Orange_Light">#ECB397</Color>
    <Color x:Key="Orange_XXXXX">#FF9800</Color>

    <!-- 中性灰 -->
    <Color x:Key="Gray_Neutral">#D1D2D3</Color>

    <!--主界面-->
    <!--顶端栏-->
    <SolidColorBrush x:Key="TopBarBg"   Color="#08204c"/>
    <SolidColorBrush x:Key="TopBarLabelBg"   Color="#3e9ae3"/>
    <SolidColorBrush x:Key="TopBarLabelTextColor"  Color="#fafafa"/>
    <SolidColorBrush x:Key="TopBarTextColor"   Color="#fafafa"/>
    <SolidColorBrush x:Key="MainContainerBg" Color="#080408"/>


    <!--RunwayStatus-->
    <SolidColorBrush x:Key="RunwayStatus.ContainerBackgroundColor.Inactive" Color="{StaticResource Bg_Blue_Dark1}"/>
    <SolidColorBrush x:Key="RunwayStatus.LabelBackgroundColor.Inactive" Color="{StaticResource Bg_Gray_Dark1}"/>
    <SolidColorBrush x:Key="RunwayStatus.LabelTextColor.Inactive" Color="{StaticResource White_Main}"/>
    <SolidColorBrush x:Key="RunwayStatus.ValueTextBackgroundColor.Inactive" Color="{StaticResource Bg_Gray_Dark3}"/>
    <SolidColorBrush x:Key="RunwayStatus.ValueTextColor.Inactive" Color="{StaticResource Bg_Gray_Light}"/>

    <SolidColorBrush x:Key="RunwayStatus.ContainerBackgroundColor.Active" Color="{StaticResource Bg_Blue_Dark1}"/>
    <SolidColorBrush x:Key="RunwayStatus.LabelBackgroundColor.Active" Color="{StaticResource Blue_Primary}"/>
    <SolidColorBrush x:Key="RunwayStatus.LabelTextColor.Active" Color="{StaticResource White_Main}"/>
    <SolidColorBrush x:Key="RunwayStatus.ValueTextBackgroundColor.Active" Color="{StaticResource Orange_Alert}"/>
    <SolidColorBrush x:Key="RunwayStatus.ValueTextColor.Active" Color="{StaticResource White_Main}"/>
    <!--WindPanel-->
    <SolidColorBrush x:Key="WindPanel.ContainerBackgroundColor.Active"  Color="#2c4c85"/>
    <SolidColorBrush x:Key="WindPanel.ContainerBackgroundColor.InActive"  Color="#233b6b"/>
    <!--HeadCrossWind-->
    <SolidColorBrush x:Key="HeadCrossWind.ContainerBackgroundColor.Active" Color="#2c4c85"/>
    <SolidColorBrush x:Key="HeadCrossWind.ContainerBackgroundColor.Inactive" Color="#233b6b"/>

    <SolidColorBrush x:Key="HeadCrossWind.LabelTextColor.Active" Color="#fafafa"/>
    <SolidColorBrush x:Key="HeadCrossWind.LabelTextColor.Inactive" Color="#7988b0"/>

    <SolidColorBrush x:Key="HeadCrossWind.LabelBackgroundColor.Active" Color="#18305e"/>
    <SolidColorBrush x:Key="HeadCrossWind.LabelBackgroundColor.Inactive" Color="#18305e"/>

    <SolidColorBrush x:Key="HeadCrossWind.ValueTextColor.Active" Color="#fafafa"/>
    <SolidColorBrush x:Key="HeadCrossWind.ValueTextColor.Inactive" Color="#7988b0"/>

    <!--QnhLight Metar-->
    <SolidColorBrush x:Key="QnhLight.ContainerBackgroundColor" Color="#2c4c85"/>
    <SolidColorBrush x:Key="QnhLight.LabelBackgroundColor" Color="#18305e"/>
    <SolidColorBrush x:Key="QnhLight.LabelTextColor" Color="#fafafa"/>
    <SolidColorBrush x:Key="QnhLight.ValueTextBackgroundColor" Color="#2c4c85"/>
    
    <SolidColorBrush x:Key="QnhLight.ValueTextColor" Color="#fafafa"/>







</ResourceDictionary>
