             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.AWOS.Components"
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="450">
    <UserControl.Resources>
        <!--是否显示-->
        <conv:TrueOnlyToVisibilityConverter x:Key="TrueOnlyToVisibility"/>
        <conv:RunwayPartVisibiltyConverter x:Key="RunwayPartVisibiltyConverter"/>

        <conv:WindPanelSegmentColorConverter x:Key="WindPanelSegmentColorConverter" />
        <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="FontFamily" Value="Cascadia Code"/>
            <Setter Property="Foreground" Value="{DynamicResource WindPanel.TextColor.InActive }"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WindPanel.TextColor.Active}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Ellipse">
            <Setter Property="Fill" Value="{Binding WindPanelBackground,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Style>


        <Style x:Key="OuterStyle" TargetType="Path" >
            <Setter Property="StrokeThickness" Value="38"/>
            <Setter Property="Stroke" Value="{DynamicResource WindPanel.OuterArcColor.OutRange.InActive}"/>
            <Style.Triggers>

                <!-- JustAhead Active -->
                <DataTrigger Value="{x:Static conv:WindSegmentState.JustAheadActive}">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource WindPanelSegmentColorConverter}">
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="statistics.DirRangeSet"/>
                            <Binding Path="IsActive"/>
                            <Binding Path="wind.AngleIndex"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Stroke"
                    Value="{DynamicResource WindPanel.OuterArcColor.JustAhead.Active}"/>
                </DataTrigger>

                <!-- JustAhead Inactive -->
                <DataTrigger Value="{x:Static conv:WindSegmentState.JustAheadInactive}">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource WindPanelSegmentColorConverter}">
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="statistics.DirRangeSet"/>
                            <Binding Path="IsActive"/>
                            <Binding Path="wind.AngleIndex"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Stroke"
                    Value="{DynamicResource WindPanel.OuterArcColor.JustAhead.InActive}"/>
                </DataTrigger>

                <!-- InRange Active -->
                <DataTrigger Value="{x:Static conv:WindSegmentState.InRangeActive}">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource WindPanelSegmentColorConverter}">
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="statistics.DirRangeSet"/>
