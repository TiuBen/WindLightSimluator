                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Stroke"
                    Value="{DynamicResource WindPanel.OuterArcColor.OutRange.InActive}"/>
                </DataTrigger>

                <!-- Error -->
