                            <Binding Path="wind.AngleIndex"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Stroke"
                    Value="{DynamicResource WindPanel.OuterArcColor.InRange.Active}"/>
                </DataTrigger>

                <!-- InRange Inactive -->
                <DataTrigger Value="{x:Static conv:WindSegmentState.InRangeInactive}">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource WindPanelSegmentColorConverter}">
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="statistics.DirRangeSet"/>
                            <Binding Path="IsActive"/>
                            <Binding Path="wind.AngleIndex"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Stroke"
                    Value="{DynamicResource WindPanel.OuterArcColor.InRange.InActive}"/>
