<UserControl x:Class="WindLightSimluator.Views.AWOS.Components.Qnh"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.AWOS.Components"
             xmlns:base="clr-namespace:WindLightSimluator.Views.Components.Base"
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             xmlns:Awos="clr-namespace:WindLightSimluator.Views.AWOS"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" >
    <UserControl.Resources>
        <!-- 定义高度到字体大小的转换器 -->
        <conv:HeightToFontSizeConverter x:Key="HeightToFontSizeConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="60"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"  
                    Value="{Binding ActualHeight, 
                    RelativeSource={RelativeSource AncestorType=Border},  
                    Converter={StaticResource  HeightToFontSizeConverter},   
                    ConverterParameter=0.5}"/>
            <Setter Property="Foreground" Value="{DynamicResource QnhLight.LabelTextColor}" />
        </Style>

    </UserControl.Resources>
    <Grid Background="{DynamicResource QnhLight.ContainerBackgroundColor}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource QnhLight.LabelBackgroundColor}">
            <TextBlock Text="QNH"   
                       Foreground="{DynamicResource QnhLight.LabelTextColor}" FontWeight="Bold"/>
        </Border>
        <base:BorderText Grid.Column="1" 
                         MainText="{Binding Qnh}" 
                         Margin="0"
                         SubText="hPa" 
                         BackgroundColor="Transparent"
                         BorderColor="Transparent"
                         MainTextColor="{DynamicResource QnhLight.ValueTextColor}"
                         SubTextColor="{DynamicResource QnhLight.ValueTextColor}"
                         MainTextFontSize="{Binding ActualHeight, 
                                     RelativeSource={RelativeSource AncestorType=Border},  
                                     Converter={StaticResource  HeightToFontSizeConverter},   
                                        ConverterParameter=0.8}"
                          MainTextFontWeight="Bold"
                         SubTextFontSize="18"
                         />
    </Grid>
</UserControl>