<UserControl x:Class="WindLightSimluator.Views.AWOS.SwitchesMuneBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.AWOS"
             mc:Ignorable="d" 
            >
    <StackPanel  Background="{DynamicResource MainBarBg}" >
        <StackPanel.Resources>

            <!-- ✅ 可复用的 Hover 样式 -->
            <Style x:Key="HoverBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="60"/>
                <Setter Property="Margin" Value="5"/>
                <!-- 默认背景 -->
                <Setter Property="Background" Value="{DynamicResource RectButtonBackgroundBrush}" />
                <Style.Triggers>

                    <!-- 👇 鼠标移入 -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RectButtonBackgroundBrushHovor}"/>
                    </Trigger>

                </Style.Triggers>

            </Style>

        </StackPanel.Resources>


        <Border Style="{StaticResource HoverBorderStyle}"     MouseLeftButtonDown="ChangeRunwayIndex0" >
            <TextBlock Text="01L_19R" Foreground="White" FontWeight="ExtraBold" FontSize="14"  VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
        <Border Style="{StaticResource HoverBorderStyle}"    MouseLeftButtonDown="ChangeRunwayIndex1">
            <TextBlock Text="01R_19L" Foreground="White" FontWeight="ExtraBold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"  />
        </Border>
        <Border Style="{StaticResource HoverBorderStyle}" x:Name="SwapWestEastButton" MouseLeftButtonUp="SwapWestEastButton_MouseLeftButtonUp">
            <TextBlock Text="东  西" Foreground="White" FontWeight="ExtraBold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"  />
        </Border>
       
    </StackPanel>
</UserControl>
