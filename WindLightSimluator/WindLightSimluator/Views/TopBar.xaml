<UserControl x:Class="WindLightSimluator.Views.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views"
             xmlns:base="clr-namespace:WindLightSimluator.Views.Components.Base"
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             mc:Ignorable="d"
             >
    <UserControl.Resources>
        <conv:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>

        <!--字体大小-->
        <conv:HeightToFontSizeConverter x:Key="HeightToFontSizeConverter"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock" >
            <Setter Property="Foreground" Value="{StaticResource TopBarLabelTextColor}"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Margin" Value="10 0 10 0"/>
        </Style>
        <Style x:Key="TextStyle" TargetType="TextBlock" >
            <Setter Property="Foreground" Value="{StaticResource TopBarTextColor}"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="10 0 10 0"/>

            <!--<Setter Property="FontSize"  Value="{Binding ActualHeight,
                        RelativeSource={RelativeSource AncestorType=Border},
                        Converter={StaticResource  HeightToFontSizeConverter} , ConverterParameter=0.5 }"/>-->
        </Style>
        <Style TargetType="base:CapsuleBorder" >
            <Setter Property="Background"  Value="{StaticResource TopBarLabelBg}"/>
        </Style>
    </UserControl.Resources>

    <Grid  Background="{StaticResource TopBarBg}">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="Container"  HorizontalAlignment="Left">
            <Grid.Resources>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="5 0 5 0"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition  Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*" />
                <ColumnDefinition  Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="OBMAN" Style="{StaticResource TextStyle}" >
                <TextBlock.FontSize>
                    <Binding    
                   Path="ActualHeight"
                    ElementName="Container"
                   Converter="{StaticResource HeightToFontSizeConverter}"
                   ConverterParameter="0.3" />
                </TextBlock.FontSize>
            </TextBlock>


            <!-- 磁差 -->
            <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <base:CapsuleBorder Grid.Row="0" >
                    <TextBlock Text="Declination" Style="{StaticResource LabelStyle}"  >
                        <TextBlock.FontSize>
                            <Binding    Path="ActualHeight"
                                      ElementName="Container"
                                    Converter="{StaticResource HeightToFontSizeConverter}"
                                    ConverterParameter="0.2" />
                        </TextBlock.FontSize>
                    </TextBlock>
                </base:CapsuleBorder>
                <TextBlock  Grid.Row="1" Text="-4.49" Style="{StaticResource TextStyle}">
                    <TextBlock.FontSize>
                        <Binding    Path="ActualHeight"
                                   ElementName="Container"
                               Converter="{StaticResource HeightToFontSizeConverter}"
                               ConverterParameter="0.2" />
                    </TextBlock.FontSize>
                </TextBlock>
            </Grid>
            <!-- BJT -->
            <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <base:CapsuleBorder Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="BJT" Style="{StaticResource LabelStyle}"  >
                        <TextBlock.FontSize>
                            <Binding 
                                Path="ActualHeight"
                               ElementName="Container"
                                Converter="{StaticResource HeightToFontSizeConverter}"
                           ConverterParameter="0.3" />
                        </TextBlock.FontSize>
                    </TextBlock>
                </base:CapsuleBorder>
                <Border Grid.Column="1"  VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock  Style="{StaticResource TextStyle}" >
                        <TextBlock.Text>
                            <Binding Path="BjtTime"
                                    Converter="{StaticResource DateTimeFormatConverter}"
                                    ConverterParameter="yyyy-MM-dd HH:mm:ss"/>
                        </TextBlock.Text>

                        <TextBlock.FontSize>
                            <Binding   Path="ActualHeight"
                                   ElementName="Container"
                                   Converter="{StaticResource HeightToFontSizeConverter}"
                                   ConverterParameter="0.3" />
                        </TextBlock.FontSize>
                    </TextBlock>
                </Border>
            </Grid>
            <!-- UTC -->
            <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <base:CapsuleBorder Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="UTC"  Style="{StaticResource LabelStyle}">
                        <TextBlock.FontSize>
                            <Binding    Path="ActualHeight"
                         ElementName="Container"
                           Converter="{StaticResource HeightToFontSizeConverter}"
                           ConverterParameter="0.4" />
                        </TextBlock.FontSize>
                    </TextBlock>
                </base:CapsuleBorder>
                <Border Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock  FontWeight="Regular" Style="{StaticResource TextStyle}" >
                        <TextBlock.Text>
                            <Binding Path="UtcTime"
                                    Converter="{StaticResource DateTimeFormatConverter}"
                                        ConverterParameter="yyyy-MM-dd HH:mm:ss"/>
                        </TextBlock.Text>
                        <TextBlock.FontSize>
                            <Binding    Path="ActualHeight"
                                      ElementName="Container"
                                       Converter="{StaticResource HeightToFontSizeConverter}"
                                       ConverterParameter="0.5" />
                        </TextBlock.FontSize>

                    </TextBlock>
                </Border>
            </Grid>

           
     
        </Grid>
        <!-- sunrise / sunset 右侧 -->
        <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- sunrise / sunset -->
            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- sunrise -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <base:CapsuleBorder Grid.Column="0">
                        <TextBlock Text="sunrise" Style="{StaticResource LabelStyle}"/>
                    </base:CapsuleBorder>
                    <TextBlock Grid.Column="1" Text="2025-12-07 17:13:50" Style="{StaticResource TextStyle}" />
                </Grid>

                <!-- sunset -->
                <Grid Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <base:CapsuleBorder Grid.Column="0">
                        <TextBlock Text="sunset" Style="{StaticResource LabelStyle}"/>
                    </base:CapsuleBorder>
                    <TextBlock Grid.Column="1" Text="2025-12-07 17:13:50" Style="{StaticResource TextStyle}" />
                </Grid>
            </Grid>

            <base:CapsuleBorder Grid.Column="1">
                <TextBlock Text="sunrise" Style="{StaticResource LabelStyle}"/>
            </base:CapsuleBorder>
            <base:CapsuleBorder Grid.Column="2">
                <TextBlock Text="suddddnset" Style="{StaticResource TextStyle}"/>
            </base:CapsuleBorder>
        </Grid>
    </Grid>


</UserControl>