<UserControl x:Class="WindLightSimluator.Views.RVRSwitch.RVRSwitch"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WindLightSimluator.Views.RVRSwitch"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
  >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:RunwayLamp LampText="01L"  Margin="15"/>
                <local:RunwayLamp LampText="19R"  Margin="15"/>
            </StackPanel>

        </Grid>
        <local:LevelIndicator  Grid.Column="1" Grid.Row="0" VerticalAlignment="Center"/>
        <local:ToggleSwitch Grid.Column="0" Grid.Row="1"  VerticalAlignment="Top"/>
        <local:KnobControl Grid.Column="1" Grid.Row="1" VerticalAlignment="Top"/>


    </Grid>
</UserControl>
