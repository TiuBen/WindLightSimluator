<UserControl x:Class="WindLightSimluator.Views.RVRSwitch.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.RVRSwitch"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Width="120" Height="120">

        <!-- 六边形底座 -->
        <Path x:Name="BaseHex"
          StrokeThickness="1"
          Stroke="#666" Margin="10,10,-10,-10" >
            <Path.Data>
                M 70.2,15 
           L 29.8,15 
           L 9.6,50 
           L 29.8,85 
           L 70.2,85 
           L 90.4,50 Z
            </Path.Data>
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E0E0E0" Offset="0"/>
                    <GradientStop Color="#FFEAEAEA" Offset="0.5"/>
                    <GradientStop Color="#606060" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>
        <Ellipse Width="70" Height="70"
HorizontalAlignment="Center"
VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FF6F6F6F" Offset="1"/>
                    <GradientStop Color="#FFECECEC" Offset="0.858"/>
                    <GradientStop Color="#FF8E8E8E" Offset="0.707"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <!-- 中心固定点 -->
        <Ellipse Width="50" Height="50"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="#FFBBBBBB" Offset="1"/>
                    <GradientStop Color="#FF737373" Offset="0.703"/>
                    <GradientStop Color="#FF929292" Offset="0.548"/>
                    <GradientStop Color="#FFC3C3C3" Offset="0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>


        <!-- 拨杆 -->
        <Path x:Name="Lever"
          Fill="#DDD"
          Stroke="#444"
          StrokeThickness="1"
          RenderTransformOrigin="0.5,0.7"
          Cursor="Hand" Margin="44,-11,41,61">

            <!-- 这个就是“头大尾小”的形状 -->
            <Path.Data>
                <PathGeometry Figures=""/>
            </Path.Data>

            <Path.RenderTransform>
                <RotateTransform x:Name="Rotate" Angle="0"/>
            </Path.RenderTransform>

        </Path>
        <Path  HorizontalAlignment="Center" Height="61" Margin="0,3,0,0"  Stretch="Fill" VerticalAlignment="Top" Width="25" RenderTransformOrigin="0.5,1">
            <Path.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="32.471"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Path.RenderTransform>
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="60,68" IsClosed="True">

                        <!-- 右侧轮廓 -->
                        <BezierSegment Point1="72,68" Point2="78,58" Point3="80,45"/>
                        <BezierSegment Point1="82,32" Point2="78,20" Point3="68,18"/>

                        <!-- 顶部（大头） -->
                        <BezierSegment Point1="62,16" Point2="58,16" Point3="52,18"/>

                        <!-- 左侧轮廓 -->
                        <BezierSegment Point1="42,20" Point2="38,32" Point3="40,45"/>
                        <BezierSegment Point1="42,58" Point2="48,68" Point3="60,68"/>

                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <!-- 金属渐变 -->
            <Path.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White" Offset="0"/>
                    <GradientStop Color="#FF6A6A6A" Offset="1"/>
                    <GradientStop Color="#FFABABAB" Offset="0.364"/>
                </LinearGradientBrush>
            </Path.Fill>
            <Path.Stroke>
                <SolidColorBrush Color="#FFA7A7A7"/>
            </Path.Stroke>
        </Path>

    </Grid>
</UserControl>
