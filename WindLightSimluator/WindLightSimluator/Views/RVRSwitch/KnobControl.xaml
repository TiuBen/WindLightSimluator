<UserControl x:Class="WindLightSimluator.Views.RVRSwitch.KnobControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.RVRSwitch"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
  Width="300" Height="300">
    <Viewbox>
        <Grid Width="200" Height="200">
            <Ellipse Fill="#FF222222">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.5"/>
                </Ellipse.Effect>
            </Ellipse>

            <Canvas IsHitTestVisible="False">
                <StackPanel Canvas.Left="94" Canvas.Top="30" Width="40" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="0" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,2" FontWeight="Bold"/>
                    <Rectangle Width="2" Height="8" Fill="White" HorizontalAlignment="Center"/>
                    <StackPanel.RenderTransform>
                        <RotateTransform Angle="-90" CenterX="0" CenterY="90"/>
                    </StackPanel.RenderTransform>
                </StackPanel>

                <StackPanel Canvas.Left="82" Canvas.Top="23" Width="40" HorizontalAlignment="Center" VerticalAlignment="Top" Height="40">
                    <TextBlock Text="1" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,2" FontWeight="Bold"/>
                    <Rectangle Width="2" Height="8" Fill="White" HorizontalAlignment="Center"/>
                    <StackPanel.RenderTransform>
                        <RotateTransform Angle="-54" CenterX="0" CenterY="90"/>
                    </StackPanel.RenderTransform>
                </StackPanel>

                <StackPanel Canvas.Left="77" Canvas.Top="12" Width="40" HorizontalAlignment="Left" VerticalAlignment="Center" Height="34">
                    <TextBlock Text="2" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,2" FontWeight="Bold"/>
                    <Rectangle Width="2" Height="8" Fill="White" HorizontalAlignment="Center"/>
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.99999999999999989" ScaleY="0.99999999999999989"/>
                            <SkewTransform/>
                            <RotateTransform Angle="-23.336"/>
                            <TranslateTransform X="-27.811529493745265" Y="4.404913533436182"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                </StackPanel>

                <StackPanel Canvas.Left="94" Width="40" HorizontalAlignment="Center" VerticalAlignment="Top" Canvas.Top="-3">
                    <TextBlock Text="3" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,2" FontWeight="Bold"/>
                    <Rectangle Width="2" Height="8" Fill="White" HorizontalAlignment="Center"/>
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.99999999999999989" ScaleY="0.99999999999999989"/>
                            <SkewTransform/>
                            <RotateTransform Angle="29.138"/>
                            <TranslateTransform X="27.811529493745265" Y="4.404913533436182"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                </StackPanel>

                <StackPanel Canvas.Left="97" Canvas.Top="-7" Width="40" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="4" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,2" FontWeight="Bold"/>
                    <Rectangle Width="2" Height="8" Fill="White" HorizontalAlignment="Center"/>
                    <StackPanel.RenderTransform>
                        <RotateTransform Angle="54" CenterX="0" CenterY="90"/>
                    </StackPanel.RenderTransform>
                </StackPanel>

                <StackPanel Canvas.Left="106" Canvas.Top="-9" Width="40" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock Text="5" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,2" FontWeight="Bold"/>
                    <Rectangle Width="2" Height="8" Fill="White" HorizontalAlignment="Center"/>
                    <StackPanel.RenderTransform>
                        <RotateTransform Angle="90" CenterX="0" CenterY="90"/>
                    </StackPanel.RenderTransform>
                </StackPanel>
            </Canvas>

            <Grid Margin="45">
                <Ellipse Fill="#FF151515">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="Black" Opacity="0.8"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse Margin="2">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF454545" Offset="0"/>
                            <GradientStop Color="#FF181818" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Rectangle Width="4" Height="18" Fill="White" 
                           VerticalAlignment="Top" HorizontalAlignment="Center" 
                           Margin="0,8,0,0" RadiusX="2" RadiusY="2">
                    <Rectangle.RenderTransform>
                        <RotateTransform x:Name="KnobRotation" Angle="-90" CenterX="2" CenterY="47"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>