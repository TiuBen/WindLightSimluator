<UserControl x:Class="WindLightSimluator.Views.RVRSwitch.KnobControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.RVRSwitch"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Width="220" Height="260">

        <!-- 背景 -->
        <Ellipse Width="120" Height="120"
                 Fill="#CFCFCF"
                 VerticalAlignment="Top" Margin="50,45,50,0"/>

        <!-- 凹陷金属环 -->
        <Ellipse Width="90" Height="90"
                 Fill="#888"
                 VerticalAlignment="Top" Margin="65,60,65,0">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#444"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 内圈 -->
        <Ellipse Width="70" Height="70"
                 Fill="#555"
                 VerticalAlignment="Top" Margin="75,70,75,0"/>

        <!-- 刻度文字 -->
        <Canvas Height="120" VerticalAlignment="Top">

            <TextBlock Text="0" Canvas.Left="20" Canvas.Top="70"/>
            <TextBlock Text="1" Canvas.Left="45" Canvas.Top="40"/>
            <TextBlock Text="2" Canvas.Left="80" Canvas.Top="20"/>
            <TextBlock Text="3" Canvas.Left="115" Canvas.Top="20"/>
            <TextBlock Text="4" Canvas.Left="150" Canvas.Top="40"/>
            <TextBlock Text="5" Canvas.Left="175" Canvas.Top="70"/>

        </Canvas>

        <!-- 旋钮本体 -->
        <Grid RenderTransformOrigin="0.5,0.8" Margin="0,-20,0,20">
            <Grid.RenderTransform>
                <RotateTransform x:Name="Rotate"/>
            </Grid.RenderTransform>

            <!-- 主体 -->
            <Path Fill="#222" Stroke="#111" StrokeThickness="1" Margin="-10,0,10,0">
                <Path.Data>
                    M 110,120 
                    C 140,110 180,110 200,120
                    L 180,145
                    C 150,155 130,155 110,145
                    Z
                </Path.Data>
            </Path>

            <!-- 高光 -->
            <Path Fill="#FFFFFF" Opacity="0.2" Margin="-10,0,10,0">
                <Path.Data>
                    M 120,122 C150,115 175,115 190,122
                </Path.Data>
            </Path>

        </Grid>

    </Grid>
</UserControl>
