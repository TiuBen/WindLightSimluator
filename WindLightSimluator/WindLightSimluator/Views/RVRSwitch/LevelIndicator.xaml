<UserControl x:Class="WindLightSimluator.Views.RVRSwitch.LevelIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.RVRSwitch"
             mc:Ignorable="d" 
            >

    <UserControl.Resources>

        <!-- 判断是否点亮 -->
        <!--<local:LevelCompareConverter x:Key="LevelCompareConverter"/>-->

        <!-- 金属外环 -->
        <Style x:Key="MetalRingStyle" TargetType="Ellipse">
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="Stroke">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F5F5F5" Offset="0"/>
                        <GradientStop Color="#C0C0C0" Offset="0.5"/>
                        <GradientStop Color="#707070" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Fill">
                <Setter.Value>
                    <RadialGradientBrush>
                        <GradientStop Color="#178b7b" Offset="0"/>
                        <GradientStop Color="#333" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 灯珠 -->
        <Style x:Key="LampStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Fill" Value="#222"/>

        </Style>

    </UserControl.Resources>

    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">

        <!-- 灯 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

            <!-- 1 -->
            <StackPanel Margin="6" HorizontalAlignment="Center">
                <Grid Width="30" Height="30">
                    <Ellipse Style="{StaticResource MetalRingStyle}"/>
                    <Ellipse Style="{StaticResource LampStyle}" Tag="1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="1级" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 2 -->
            <StackPanel Margin="6" HorizontalAlignment="Center">
                <Grid Width="30" Height="30">
                    <Ellipse Style="{StaticResource MetalRingStyle}"/>
                    <Ellipse Style="{StaticResource LampStyle}" Tag="2"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="2级" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 3 -->
            <StackPanel Margin="6" HorizontalAlignment="Center">
                <Grid Width="30" Height="30">
                    <Ellipse Style="{StaticResource MetalRingStyle}"/>
                    <Ellipse Style="{StaticResource LampStyle}" Tag="3"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="3级" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 4 -->
            <StackPanel Margin="6" HorizontalAlignment="Center">
                <Grid Width="30" Height="30">
                    <Ellipse Style="{StaticResource MetalRingStyle}"/>
                    <Ellipse Style="{StaticResource LampStyle}" Tag="4"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="4级" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 5 -->
            <StackPanel Margin="6" HorizontalAlignment="Center">
                <Grid Width="30" Height="30">
                    <Ellipse Style="{StaticResource MetalRingStyle}"/>
                    <Ellipse Style="{StaticResource LampStyle}" Tag="5"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="5级" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

        </StackPanel>

    </StackPanel>
</UserControl>