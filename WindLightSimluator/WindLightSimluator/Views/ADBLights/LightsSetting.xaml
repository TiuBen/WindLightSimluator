<UserControl x:Class="WindLightSimluator.Views.Lights.LightsSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.Lights"
             xmlns:comps="clr-namespace:WindLightSimluator.Views.Lights"
             xmlns:vm="clr-namespace:WindLightSimluator.ViewModels"
             xmlns:base="clr-namespace:WindLightSimluator.Views.Components.Base"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920">
    <UserControl.DataContext>
        <vm:ADBLightsVM/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <Style TargetType="TextBlock" >
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style TargetType="comps:LightsPartButton" >
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#404040" >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Grid Margin="40" x:Name="MainContent">

            <Viewbox Stretch="Uniform" Margin="200">
                <Image  Source="/灯光系统.png" />
            </Viewbox>
            <comps:LightsPartButton  VerticalAlignment="Top" HorizontalAlignment="Left" Margin="374,153,0,0" Text1="01L 关闭" Text2="夜晚" Text3="2档"/>
            <comps:LightsPartButton  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,153,300,0" Text1="01L 关闭" Text2="夜晚" Text3="2档"/>
            <comps:LightsPartButton  VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="374,0,0,150" Text1="01L 关闭" Text2="夜晚" Text3="2档"/>
            <comps:LightsPartButton  VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,300,150" Text1="01L 关闭" Text2="夜晚" Text3="2档"/>
            <comps:LightsPartButton  Margin="1086,0,0,0" Text1="机坪" Text2="夜晚" Text3="2档" VerticalAlignment="Center"/>
            <StackPanel HorizontalAlignment="Left" Margin="20,30,0,100">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="LawnGreen"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="30"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style TargetType="Border">
                        <Setter Property="Margin" Value="0,5,0,5"/>
                        <Setter Property="BorderBrush" Value="LightGray"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Padding" Value="20,10,20,10"/>
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </StackPanel.Resources>
                <Border >
                    <TextBlock Text="塔台1"/>
                </Border>
                <Border >
                    <TextBlock Text="01L - 19R"/>
                </Border>
                <Border >
                    <TextBlock Text="01R - 19L"/>
                </Border>
            </StackPanel>
            <Border HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,505,0,0" Height="140" Width="200" Padding="20" BorderThickness="2" BorderBrush="LightGray">
                <TextBlock Text="二类运行" FontSize="40" FontWeight="Bold" Foreground="LightGray" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Height="80" VerticalAlignment="Bottom" Background="#377477" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Wheat" FontSize="20" Text="FAKE LIGHTS CONTROL SYSTEM"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Wheat" FontSize="20" Text="FAKE LIGHTS CONTROL SYSTEM"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Wheat" FontSize="20" Text="FAKE LIGHTS CONTROL SYSTEM"/>
            <Button x:Name="OpenDialogButton" Content="打开对话框" Width="120" Height="30" Click="OpenDialogButton_Click"/>
        </Grid>
        <Border x:Name="DialogPopup"  >
            <!-- Popup 的内容：背景遮罩 + 对话框 -->
            <Grid>

                <!-- 1. 半透明黑色遮罩层，点击可关闭 -->
                <Border Background="#80000000" />

                <!-- 2. 真正的对话框（居中显示） -->
                <Border Background="#8032897a" Width="500" Height="300" Padding="20 10">
                    <StackPanel Background="Transparent" HorizontalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="Border" >
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="White" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="Padding" Value="10 2 10 2" />
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="这是一个对话框" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                        <Border BorderBrush="White" Height="2" BorderThickness="2" Width="400" ></Border>
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="20" Height="20" Source="/落地.png"/>
                                    <TextBlock FontSize="20" Grid.Column="1" Text="降落"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="20" Height="20" Source="/起飞.png"/>
                                    <TextBlock Grid.Column="1" Text="起飞"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="20" Height="20" Source="/起飞.png"/>
                                    <TextBlock Grid.Column="1" Text="关闭"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" HorizontalAlignment="Stretch" >
                                <TextBlock FontSize="20" Grid.Column="1" Text="白天"/>
                            </Border>
                            <Border Grid.Column="1" HorizontalAlignment="Stretch" >
                                <TextBlock Grid.Column="1" Text="夜间"/>
                            </Border>

                        </Grid>
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" >
                                <TextBlock FontSize="20" Grid.Column="1" Text="0档"/>
                            </Border>
                            <Border Grid.Column="1">
                                <TextBlock Grid.Column="1" Text="1档"/>
                            </Border>
                            <Border Grid.Column="2">
                                <TextBlock Grid.Column="1" Text="2档"/>
                            </Border>
                            <Border Grid.Column="3" >
                                <TextBlock FontSize="20" Grid.Column="1" Text="3档"/>
                            </Border>
                            <Border Grid.Column="4">

                                <TextBlock Grid.Column="1" Text="4档"/>
                            </Border>
                            <Border Grid.Column="5">
                                <TextBlock Grid.Column="1" Text="5档"/>
                            </Border>
                        </Grid>
                        <Button x:Name="CloseDialogButton" 
                                Content="关闭" 
                                Width="80" Height="30" 
                                Margin="0,30,0,0" 
                                HorizontalAlignment="Right"
                                Click="CloseDialogButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
