<UserControl x:Class="WindLightSimluator.Views.Components.RunwayStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.Components"
             xmlns:base="clr-namespace:WindLightSimluator.Views.Components.Base"
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             mc:Ignorable="d" 
             d:Height="80" d:Width="300"
            >
    <UserControl.Resources>
        <!--是否显示-->
        <conv:TrueOnlyToVisibilityConverter x:Key="TrueOnlyToVisibility"/>

        <!--字体大小-->
        <conv:HeightToFontSizeConverter x:Key="HeightToFontSizeConverter"/>
        <Style  TargetType="Grid" >
            <Setter Property="Margin" Value="0 0 0 0"/>
        </Style>
        <Style  TargetType="Border" >
            <Setter Property="Margin" Value="0 0 2 2"/>
            <Setter Property="Background" Value="{Binding LabelBackgroundColor,RelativeSource={RelativeSource AncestorType=local:RunwayStatus}}"/>
        </Style>
        <Style x:Key="PathBgStyle" TargetType="Path" >
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Fill" Value="{Binding LabelBackgroundColor,RelativeSource={RelativeSource AncestorType=local:RunwayStatus}}"/>
        </Style>


        <Style x:Key="baseTextStyle" TargetType="TextBlock" >
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Padding" Value="4 0 4 0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="largeText" TargetType="TextBlock"  BasedOn="{StaticResource baseTextStyle}" >
            <Setter Property="Foreground" Value="{Binding LabelTextColor,RelativeSource={RelativeSource AncestorType=local:RunwayStatus}}" />
            <Setter Property="FontSize"  Value="{Binding ActualHeight,
                    RelativeSource={RelativeSource AncestorType=Grid},
                    Converter={StaticResource  HeightToFontSizeConverter}, 
                    ConverterParameter=0.45}"/>
        </Style>
        <Style x:Key="smallText" TargetType="TextBlock" BasedOn="{StaticResource baseTextStyle}" >
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{Binding ValueTextColor,RelativeSource={RelativeSource AncestorType=local:RunwayStatus}}" />
            <Setter Property="FontSize"  Value="{Binding ActualHeight,
                    RelativeSource={RelativeSource AncestorType=Grid},
                    Converter={StaticResource  HeightToFontSizeConverter}, 
                    ConverterParameter=0.2}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{Binding ContainerBackgroundColor,RelativeSource={RelativeSource AncestorType=local:RunwayStatus}}"   >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <Grid >
            <!-- ===============================
             左边倒直角梯形（100%自适应）
             =============================== -->
            <Viewbox Stretch="Fill">
                <!-- 标准化成 100x100 的比例路径 -->
                <Path Style="{DynamicResource PathBgStyle}" >

                    <Path.Data>
                        <!-- 倒直角梯形：左边直角，右下是钝角 -->
                        <PathGeometry>
                            <PathFigure StartPoint="0,0" IsClosed="True">
                                <LineSegment Point="100,0"/>
                                <!-- 右上 -->
                                <LineSegment Point="80,100"/>
                                <!-- 右下（钝角位置） -->
                                <LineSegment Point="0,100"/>
                                <!-- 左下 -->
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Viewbox>
            <TextBlock Text="{Binding RunwayNumber}"  Style="{DynamicResource largeText}"  />
        </Grid>

        <!-- 右侧：胶囊形状态条 -->
        <Grid Grid.Column="2"  Margin="0,0,10,0" Visibility="{Binding IsActive,Converter={StaticResource TrueOnlyToVisibility} }" >
            <!-- 我们把 Border 的高度绑定到 UserControl 的 Height（可以用 Padding 调整内缩） -->
            <base:CapsuleBorder 
                    x:Name="StatusBorder"
                    Background="{Binding ValueTextBackgroundColor,RelativeSource={RelativeSource AncestorType=local:RunwayStatus}}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    >
                <!-- 内容区：居中显示状态文字 -->
                <TextBlock Text="{Binding RunwayStatusText}" Style="{DynamicResource smallText}" Margin="5"/>
                <!-- 说明：上面状态文字的 FontSize 我设置为 RunwayFontSize 的某个比例（可调），避免状态字太大 -->
            </base:CapsuleBorder>
        </Grid>

    </Grid>
</UserControl>

<!--Background="{Binding  ValueTextBackgroundColor,RelativeSource={RelativeSource AncestorType=local:RunwayStatus}}"-->
    