<UserControl x:Class="WindLightSimluator.Views.Components.WindPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.Components"
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:WindPanelSegmentColorConverter x:Key="WindPanelSegmentColorConverterOuter" 
                                              ActiveBrush="{StaticResource  WindPanelArcRangeColor.Active}"
                                              InactiveBrush="{StaticResource WindPanelArcColor.InActive}"/>
        <conv:WindPanelSegmentColorConverter x:Key="WindPanelSegmentColorConverterInner" 
                                        ActiveBrush="{StaticResource  WindPanelArcRangeColor.Active}"
                                        InactiveBrush="{StaticResource WindPanelArcColor.InActive}"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding WindPanelTextColor,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{Binding WindPanelTextColor,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Style>
        <Style TargetType="Ellipse">
            <Setter Property="Fill" Value="{Binding WindPanelBackground,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Style>
        
        
        <Style x:Key="OuterStyle" TargetType="Path" >
            <Setter Property="StrokeThickness" Value="28"/>
            <Setter Property="Stroke">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource WindPanelSegmentColorConverterOuter}">
                        <!-- 当前 Path 的 Tag -->
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        <!-- VM 里的集合 -->
                        <Binding Path="DataContext.Statistics.DirRangeSet" RelativeSource="{RelativeSource AncestorType=local:WindPanel}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InnerStyle" TargetType="Path" >
            <Setter Property="StrokeThickness" Value="22"/>
            <Setter Property="Stroke">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource WindPanelSegmentColorConverterInner}">
                        <!-- 当前 Path 的 Tag -->
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        <!-- VM 里的集合 -->
                        <Binding Path="DataContext.Statistics.DirRangeSet" RelativeSource="{RelativeSource AncestorType=local:WindPanel}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <!--整个背景色-->
        <Style x:Key="ContainerBackgroundColor" TargetType="Grid" >
            <Setter Property="Background" Value="{DynamicResource WindPanel.ContainerBackgroundColor.InActive}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WindPanel.ContainerBackgroundColor.Active}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>


    </UserControl.Resources>
