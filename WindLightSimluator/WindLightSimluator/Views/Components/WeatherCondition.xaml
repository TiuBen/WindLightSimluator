<UserControl x:Class="WindLightSimluator.Views.Components.WeatherCondition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.Components"
             xmlns:base="clr-namespace:WindLightSimluator.Views.Components.Base"
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             mc:Ignorable="d" 
            >
    <UserControl.Resources>
        <!--主题颜色+是否被选中-->
        <conv:ThemeActiveColorConverter x:Key="ThemeActiveColorConverter"/>
        <!--字体大小-->
        <conv:HeightToFontSizeConverter x:Key="HeightToFontSizeConverter"/>

        <Style  TargetType="Border" >
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{Binding LabelBackgroundColor,RelativeSource={RelativeSource AncestorType=local:WeatherCondition}}"/>
        </Style>
        <Style TargetType="TextBlock" >
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Padding" Value="10 0 10 0"/>
            <Setter Property="Foreground" Value="{Binding LabelTextColor,RelativeSource={RelativeSource AncestorType=local:WeatherCondition}}" />
            <Setter Property="FontSize"  Value="{Binding ActualHeight,
               RelativeSource={RelativeSource AncestorType=Border},
               Converter={StaticResource  HeightToFontSizeConverter}}"/>
        </Style>
        <Style TargetType="base:BorderText" >
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThicknessValue" Value="0"/>
            <Setter Property="SubText" Value="mps"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="MainTextColor" Value="{Binding ValueTextColor,RelativeSource={RelativeSource AncestorType=local:WeatherCondition}}" />
            <Setter Property="SubTextColor" Value="{Binding ValueTextColor,RelativeSource={RelativeSource AncestorType=local:WeatherCondition}}" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{Binding ContainerBackgroundColor,RelativeSource={RelativeSource  AncestorType=local:WeatherCondition}}"   >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="3*" />
            <RowDefinition Height="2"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!--第一列-->
        <Border   Grid.Row="0" Grid.Column="0" >
            <TextBlock Text="Cloud 1st layer"/>
        </Border>
        <base:BorderText MainText="{Binding CloudFirstLayer}" SubText="m" Grid.Row="2" Grid.Column="0"/>
        <Border Grid.Row="4" Grid.Column="0">
            <TextBlock Text="T"/>
        </Border>
        <base:BorderText MainText="{Binding Temperature}" SubText="°C" Grid.Row="6" Grid.Column="0"/>

        <!--第二列-->
        <Border Grid.Row="0" Grid.Column="2">
            <TextBlock Text="    VVIS    "/>
        </Border>
        <base:BorderText MainText="{Binding VVIS}" SubText="m" Grid.Row="2" Grid.Column="2"/>
        <Border Grid.Row="4" Grid.Column="2">
            <TextBlock Text="DP"/>
        </Border>
        <base:BorderText MainText="{Binding Duepoint}" SubText="°C" Grid.Row="6" Grid.Column="2"/>
        <!--第三列-->
        <Border Grid.Row="0" Grid.Column="4">
            <TextBlock Text="Rain 1h"/>
        </Border>
        <base:BorderText MainText="{Binding Rain1h}" SubText="mm" Grid.Row="2" Grid.Column="4"/>
        <Border Grid.Row="4" Grid.Column="4">
            <TextBlock Text="RH"/>
        </Border>
        <base:BorderText MainText="{Binding RelativeHumidity}" SubText="%" Grid.Row="6" Grid.Column="4"/>
        <!--第四列-->
        <Border Grid.Row="0" Grid.Column="6">
            <TextBlock Text="Rain 24h"/>
        </Border>
        <base:BorderText MainText="{Binding Rain24h}" SubText="mm" Grid.Row="2" Grid.Column="6"/>
        <Border Grid.Row="4" Grid.Column="6">
            <TextBlock Text="QFE"/>
        </Border>
        <base:BorderText MainText="{Binding QFE}" SubText="hPa" Grid.Row="6" Grid.Column="6"/>
        <!--第五列-->
        <Border Grid.Row="0" Grid.Column="8">
            <TextBlock Text="STEMP"/>
        </Border>
        <base:BorderText MainText="{Binding SurfaceTemperature}" SubText="°C" Grid.Row="2" Grid.Column="8"/>
        <Border Grid.Row="4" Grid.Column="8">
            <TextBlock Text="STATUS"/>
        </Border>
        <base:BorderText MainText="{Binding Status}" SubText="" Grid.Row="6" Grid.Column="8"/>
    </Grid>




</UserControl>
