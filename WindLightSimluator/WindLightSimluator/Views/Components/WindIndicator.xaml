<UserControl x:Class="WindLightSimluator.Views.Components.WindIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="400">
    <Grid>


        <Canvas Width="400" Height="400">

            <ItemsControl>
                <!-- 生成 0~350，每隔 10 度 -->
                <ItemsControl.ItemsSource>
                    <x:Array Type="sys:Double"
      xmlns:sys="clr-namespace:System;assembly=mscorlib">
                        <sys:Double>0</sys:Double>
                        <sys:Double>15</sys:Double>
                        <sys:Double>30</sys:Double>
                        <sys:Double>45</sys:Double>
                        <sys:Double>60</sys:Double>
                        <sys:Double>75</sys:Double>
                        <sys:Double>90</sys:Double>
                        <sys:Double>105</sys:Double>
                        <sys:Double>120</sys:Double>
                        <sys:Double>135</sys:Double>
                        <sys:Double>150</sys:Double>
                        <sys:Double>165</sys:Double>
                        <sys:Double>180</sys:Double>
                        <sys:Double>195</sys:Double>
                        <sys:Double>210</sys:Double>
                        <sys:Double>225</sys:Double>
                        <sys:Double>240</sys:Double>
                        <sys:Double>255</sys:Double>
                        <sys:Double>270</sys:Double>
                        <sys:Double>285</sys:Double>
                        <sys:Double>300</sys:Double>
                        <sys:Double>315</sys:Double>
                        <sys:Double>330</sys:Double>
                        <sys:Double>345</sys:Double>

                    </x:Array>
                </ItemsControl.ItemsSource>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Polygon Points="0,0 34,0 32,16 2,16"
                           Fill="red" Opacity="0.9"
                           Width="36" Height="16"
                           RenderTransformOrigin="0.5,10">

                            <Polygon.RenderTransform>
                                <TransformGroup>
                                    <!-- 旋转角度绑定 -->
                                    <RotateTransform Angle="{Binding}"/>

                                    <!-- 向外平移（半径=150 可改） -->
                                    <TranslateTransform X="-15"  Y="-160"/>

                                </TransformGroup>
                            </Polygon.RenderTransform>

                        </Polygon>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <!-- 放到画布中心 -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="FrameworkElement">
                        <Setter Property="Canvas.Left" Value="200"/>
                        <Setter Property="Canvas.Top"  Value="200"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>


            </ItemsControl>
            <ItemsControl>
                <!-- 生成 0~350，每隔 10 度 -->
                <ItemsControl.ItemsSource>
                    <x:Array Type="sys:Double"
xmlns:sys="clr-namespace:System;assembly=mscorlib">
                        <sys:Double>0</sys:Double>
                        <sys:Double>15</sys:Double>
                        <sys:Double>30</sys:Double>
                        <sys:Double>45</sys:Double>
                        <sys:Double>60</sys:Double>
                        <sys:Double>75</sys:Double>
                        <sys:Double>90</sys:Double>
                        <sys:Double>105</sys:Double>
                        <sys:Double>120</sys:Double>
                        <sys:Double>135</sys:Double>
                        <sys:Double>150</sys:Double>
                        <sys:Double>165</sys:Double>
                        <sys:Double>180</sys:Double>
                        <sys:Double>195</sys:Double>
                        <sys:Double>210</sys:Double>
                        <sys:Double>225</sys:Double>
                        <sys:Double>240</sys:Double>
                        <sys:Double>255</sys:Double>
                        <sys:Double>270</sys:Double>
                        <sys:Double>285</sys:Double>
                        <sys:Double>300</sys:Double>
                        <sys:Double>315</sys:Double>
                        <sys:Double>330</sys:Double>
                        <sys:Double>345</sys:Double>

                    </x:Array>
                </ItemsControl.ItemsSource>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Polygon Points="2,2 18,2 16,14 4,14"
                     Fill="Yellow" Opacity="0.9"
                     Width="20" Height="16"
                     RenderTransformOrigin="0.5,9">

                            <Polygon.RenderTransform>
                                <TransformGroup>
                                    <!-- 旋转角度绑定 -->
                                    <RotateTransform Angle="{Binding}"/>

                                    <!-- 向外平移（半径=150 可改） -->
                                    <TranslateTransform X="-10"  Y="-144"/>

                                </TransformGroup>
                            </Polygon.RenderTransform>

                        </Polygon>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <!-- 放到画布中心 -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="FrameworkElement">
                        <Setter Property="Canvas.Left" Value="200"/>
                        <Setter Property="Canvas.Top"  Value="200"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>

            </ItemsControl>


            <ItemsControl>
                <!-- 生成 0~350，每隔 10 度 -->
                <ItemsControl.ItemsSource>
                    <x:Array Type="sys:Double"
                   xmlns:sys="clr-namespace:System;assembly=mscorlib">
                        <sys:Double>0</sys:Double>
                        <sys:Double>90</sys:Double>
                        <sys:Double>180</sys:Double>
                        <sys:Double>270</sys:Double>

                    </x:Array>
                </ItemsControl.ItemsSource>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Polygon Points="0,0 16,0 14,12 2,12"
                     Fill="Blue" Opacity="0.9"
                     Width="16" Height="12"
                     RenderTransformOrigin="0.5,14">

                            <Polygon.RenderTransform>
                                <TransformGroup>
                                    <!-- 旋转角度绑定 -->
                                    <RotateTransform Angle="{Binding}"/>

                                    <!-- 向外平移（半径=150 可改） -->
                                    <TranslateTransform X="-8" Y="-162"/>
                                </TransformGroup>
                            </Polygon.RenderTransform>

                        </Polygon>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <!-- 放到画布中心 -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="FrameworkElement">
                        <Setter Property="Canvas.Left" Value="200"/>
                        <Setter Property="Canvas.Top"  Value="200"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>

            </ItemsControl>
        </Canvas>

    </Grid>
</UserControl>
