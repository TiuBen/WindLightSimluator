<UserControl x:Class="WindLightSimluator.Views.Lights.LightsPartButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindLightSimluator.Views.Lights"
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="140">
    <UserControl.Resources>
        <Style TargetType="TextBox" >
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>

        </Style>
    </UserControl.Resources>
    <Border   BorderThickness="4" BorderBrush="White" Padding="3">
        <Grid Width="120" Height="120" Background="Transparent"   >
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
          
            <TextBox Grid.Row="0" Text="{Binding Text1, ElementName=parent}" />
            <TextBox Grid.Row="1" Text="{Binding Text2, ElementName=parent}" />
            <TextBox Grid.Row="2" Text="{Binding Text3, ElementName=parent}" />
        </Grid>
    </Border>
</UserControl>
