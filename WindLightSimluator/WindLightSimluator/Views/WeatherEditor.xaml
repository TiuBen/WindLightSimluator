<UserControl x:Class="WindLightSimluator.Views.WeatherEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:comp="clr-namespace:WindLightSimluator.Views.Components"
             xmlns:vm="clr-namespace:WindLightSimluator.ViewModels"
             xmlns:conv="clr-namespace:WindLightSimluator.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1980">
    <UserControl.DataContext>
        <vm:EditableWeatherElementViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- 左侧字段选择 -->
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>


            <!--数据库-->
            <Grid Grid.Row="0" Background="LightBlue"  >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Margin="4" Content="选择数据库" Click="SelectDatabaseButton_Click" />

                <ListBox Grid.Row="2" x:Name="CsvListBox" Margin="4 0 4 0" ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" />
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Margin="4">复制练习</Button>
                    <Button Grid.Column="1" Margin="4" Click="NewTableButton_Click">新建练习</Button>
                </Grid>
            </Grid>

            <!--重命名-->
            <Grid Grid.Row="1" Background="LightBlue" Margin="0 5 0 5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="4 0 ">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Label  HorizontalAlignment="Center" Foreground="Blue" FontWeight="Bold" FontSize="18" Content="已选练习名称"/>
                    <Label Grid.Row="1" x:Name="SelectedFileLabel"  Content="{Binding SelectedTable}" Background="Black" Foreground="White" MinHeight="22"></Label>
                </Grid>
                <Label Grid.Row="1" FontSize="10" Content="新名称只允许字母数字,15个以内"/>
                <Grid Grid.Row="2" Margin="4 ">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox  Text="{Binding NewTableName, UpdateSourceTrigger=PropertyChanged}"  IsEnabled="{Binding SelectedTable, Converter={StaticResource NullToBoolConverter}}" MaxLength="15"  />
                    <Button Grid.Column="1" IsEnabled="{Binding CanRename}" Click="ChangeNameButton_Click" >确定</Button>
                </Grid>
            </Grid>
            <!--编辑项目-->
            <StackPanel Grid.Row="2" Background="LightBlue" Margin="0 0 0 5" >
                <Label   HorizontalAlignment="Center"  FontSize="16" Content="可编辑项"/>
                <ListBox Margin="4" ItemsSource="{Binding FieldList}" SelectedItem="{Binding SelectedField}"/>
                <StackPanel Margin="4 0 0 4">

                    <TextBlock Text="{Binding CurrentConfig.Unit, StringFormat='单位: {0}'}" />
                    <TextBlock Text="{Binding CurrentConfig.BaseValue,StringFormat='默认初始值: {0}' }" />
                    <TextBlock Text="{Binding CurrentConfig.Min, StringFormat='最小可用值: {0}'}"/>
                    <TextBlock Text="{Binding CurrentConfig.Max, StringFormat='最大可用值: {0}'}"/>
                    <TextBlock Text="{Binding CurrentConfig.Step, StringFormat='步长: {0}'}"/>
                </StackPanel>
            </StackPanel>

            <!--编辑练习-->
            <Grid Grid.Row="3" >
                <Button   FontSize="18" Click="Save_Click" >保存修改</Button>
            </Grid>
        </Grid>
        <!-- 曲线编辑器 -->
        <comp:GridPointEditor  Grid.Column="1" 
                               Points="{Binding SelectedFieldPoints}" 
                               FieldConfig="{Binding SelectedFieldConfig}" 
                               PointValueChanged="GridPointEditor_PointValueChanged"/>
    </Grid>
</UserControl>
