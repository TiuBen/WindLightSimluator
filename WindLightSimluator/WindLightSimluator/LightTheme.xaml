        <GradientStop Color="#FF7CC1F9" Offset="0.607"/>
        <GradientStop Color="#FF5595CA"/>
        <GradientStop Color="#FF42A1EF" Offset="0.197"/>
    </LinearGradientBrush>
  
    <LinearGradientBrush x:Key="RectButtonBackgroundBrushHovor" EndPoint="0.5,1" StartPoint="0.5,0">
