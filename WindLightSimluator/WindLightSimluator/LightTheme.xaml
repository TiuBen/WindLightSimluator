    <SolidColorBrush x:Key="WindPanel.ContainerBackgroundColor.Active"  Color="#FAFAFA"/>
    <SolidColorBrush x:Key="WindPanel.ContainerBackgroundColor.InActive"  Color="#f1f2f6"/>

