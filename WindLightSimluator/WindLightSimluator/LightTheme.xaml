    <SolidColorBrush x:Key="WindPanel.InnerArcColor.OutRange.Active" Color="#cecece"/>
    <SolidColorBrush x:Key="WindPanel.InnerArcColor.OutRange.InActive" Color="#e2e1e5"/>


    <SolidColorBrush x:Key="WindPanel.Bg.Active"  Color="#FAFAFA"/>
    <SolidColorBrush x:Key="WindPanel.Bg.InActive"  Color="#F1F2F6"/>
    <SolidColorBrush x:Key="WindPanel.TextColor.Active"  Color="#080408"/>
    <SolidColorBrush x:Key="WindPanel.TextColor.InActive"  Color="#A3A7B1"/>


</ResourceDictionary>


