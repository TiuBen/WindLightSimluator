<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="MainBgColor">#ffff</Color>
    <Color x:Key="PrimaryTextColor"></Color>
    <Color x:Key="SecondaryTextBrush"></Color>
    <Color x:Key="TertiaryTextBrush"></Color>
    <Color x:Key="PrimaryTextBgColor"></Color>
    <Color x:Key="SecondaryTextBgBrush"></Color>
    <Color x:Key="TertiaryTextBgBrush"></Color>
    <Color x:Key="WindSmallArcOuterColor"></Color>
    <Color x:Key="WindSmallArcInnerColor"></Color>

    <Color x:Key="RunwayLabelInUseBgColor">#0095ff</Color>
    <Color x:Key="RunwayLabelNotInUseTextColor">#456c92</Color>
    <Color x:Key="RunwayLabelIndicatorBgColor">#d53700</Color>

    
    <!-- 主背景 / 面板灰 -->
    <Color x:Key="Bg_Gray_Main">#A3A7B1</Color>
    <Color x:Key="Bg_Gray_Light">#DCE0E9</Color>
    <Color x:Key="Bg_Gray_Lighter">#F1F2F6</Color>
    <Color x:Key="Bg_Gray_Dark">#7F869C</Color>
    <Color x:Key="Bg_Gray_Dark1">#7b83a5</Color>
    <Color x:Key="Bg_Gray_Dark2">#7F869C</Color>
    <Color x:Key="Bg_Gray_Dark3">#aab8db</Color>

    <!-- 纯白 / 高亮 -->
    <Color x:Key="White_Main">#FAFAFA</Color>
    <Color x:Key="White_Off">#F9FAFA</Color>

    <!-- 蓝色系（主界面核心色） -->
    <Color x:Key="Blue_DarkPrimary">#0061a7</Color>
    <Color x:Key="Blue_Primary">#3e9ae3</Color>
    <Color x:Key="Blue_Deep">#166096</Color>
    <Color x:Key="Blue_Mid">#5595CA</Color>
    <Color x:Key="Blue_Light">#AABBD9</Color>
    <Color x:Key="Blue_Lighter">#E0EEFD</Color>
    <Color x:Key="Blue_Lighter2">#b7d9ea</Color>
    <Color x:Key="Blue_Pale">#C8E3F8</Color>
    <Color x:Key="Blue_Alt1">#7CABD4</Color>
    <Color x:Key="Blue_Alt2">#5A75AB</Color>
    <Color x:Key="Blue_Alt3">#265bc6</Color>

    <!-- 深色文字 / 刻度 -->
    <Color x:Key="Text_Dark">#363939</Color>
    <Color x:Key="Text_Darker">#080408</Color>
    <Color x:Key="Text_Muted">#525B58</Color>

    <!-- 橙色 / 警示 / 风向箭头 -->
    <Color x:Key="Orange_Alert">#EC7439</Color>
    <Color x:Key="Orange_Light">#ECB397</Color>
    <Color x:Key="Orange_XXXXX">#FF9800</Color>

    <!-- 中性灰 -->
    <Color x:Key="Gray_Neutral">#D1D2D3</Color>


    <!--顶端栏-->
    <SolidColorBrush x:Key="TopBarBg"   Color="{StaticResource Blue_Primary}"/>
    <SolidColorBrush x:Key="TopBarLabelBg"   Color="{StaticResource Bg_Gray_Lighter}"/>
    <SolidColorBrush x:Key="TopBarLabelTextColor"  Color="{StaticResource Blue_Primary}"/>
    <SolidColorBrush x:Key="TopBarTextColor"   Color="{StaticResource White_Main}"/>
    <SolidColorBrush x:Key="MainContainerBg"   Color="{StaticResource Blue_Lighter}"/>
    
    <!--RunwayStatus-->
    <SolidColorBrush x:Key="RunwayStatus.ContainerBackgroundColor.Inactive" Color="{StaticResource Bg_Gray_Lighter}"/>
    <SolidColorBrush x:Key="RunwayStatus.LabelBackgroundColor.Inactive" Color="{StaticResource Bg_Gray_Dark3}"/>
    <SolidColorBrush x:Key="RunwayStatus.LabelTextColor.Inactive" Color="{StaticResource Bg_Gray_Dark1}"/>
    <SolidColorBrush x:Key="RunwayStatus.ValueTextBackgroundColor.Inactive" Color="{StaticResource Bg_Gray_Dark3}"/>
    <SolidColorBrush x:Key="RunwayStatus.ValueTextColor.Inactive" Color="{StaticResource White_Main}"/>

    <SolidColorBrush x:Key="RunwayStatus.ContainerBackgroundColor.Active" Color="{StaticResource White_Main}"/>
    <SolidColorBrush x:Key="RunwayStatus.LabelBackgroundColor.Active" Color="{StaticResource Blue_Primary}"/>
    <SolidColorBrush x:Key="RunwayStatus.LabelTextColor.Active" Color="{StaticResource White_Main}"/>
    <SolidColorBrush x:Key="RunwayStatus.ValueTextBackgroundColor.Active" Color="{StaticResource Orange_Alert}"/>
    <SolidColorBrush x:Key="RunwayStatus.ValueTextColor.Active" Color="{StaticResource White_Main}"/>


    <!--WindPanel-->
    <SolidColorBrush x:Key="WindPanel.ContainerBackgroundColor.Active"  Color="{StaticResource White_Main}"/>
    <SolidColorBrush x:Key="WindPanel.ContainerBackgroundColor.InActive"  Color="{StaticResource Bg_Gray_Lighter}"/>

 

    <SolidColorBrush x:Key="WindPanelArcDirectedHeadColor.Active" Color="#EC7439"/>
    <SolidColorBrush x:Key="WindPanelArcRangeColor.Active" Color="{StaticResource Blue_DarkPrimary}"/>
    <SolidColorBrush x:Key="WindPanelArcDirectedHeadColor.InActive" Color="#ECB397"/>
    <SolidColorBrush x:Key="WindPanelArcRangeColor.InActive" Color="#ECB397"/>
    <SolidColorBrush x:Key="WindPanelArcColor.Active" Color="#D1D2D3"/>
    <SolidColorBrush x:Key="WindPanelArcColor.InActive" Color="#DCE0E9"/>

    <SolidColorBrush x:Key="WindPanelOuterTagColor.InRange.Active" Color="{StaticResource Blue_DarkPrimary}"/>
    <SolidColorBrush x:Key="WindPanelOuterTagColor.InRange.InActive" Color="{StaticResource Blue_DarkPrimary}"/>
    <SolidColorBrush x:Key="WindPanelOuterTagColor.OutRange.Active" Color="{StaticResource Blue_DarkPrimary}"/>
    <SolidColorBrush x:Key="WindPanelOuterTagColor.OutRange.InActive" Color="{StaticResource Blue_Alt1}"/>



    <SolidColorBrush x:Key="WindPanelBg.Active"  Color="{StaticResource White_Main}"/>
    <SolidColorBrush x:Key="WindPanelBg.InActive"  Color="{StaticResource Bg_Gray_Lighter}"/>
    <SolidColorBrush x:Key="WindPanelTextColor.Active"  Color="{StaticResource Text_Darker}"/>
    <SolidColorBrush x:Key="WindPanelTextColor.InActive"  Color="{StaticResource Bg_Gray_Main}"/>
    
    <!--HeadCrossWind-->
    <SolidColorBrush x:Key="HeadCrossWind.ContainerBackgroundColor.Inactive" Color="{StaticResource Bg_Gray_Lighter}"/>
    <SolidColorBrush x:Key="HeadCrossWind.ContainerBackgroundColor.Active" Color="{StaticResource White_Main}"/>

    <SolidColorBrush x:Key="HeadCrossWind.LableBgColor.Inactive" Color="{StaticResource Bg_Gray_Dark1}"/>
    <SolidColorBrush x:Key="HeadCrossWind.LableBgColor.Active" Color="{StaticResource Bg_Gray_Light}"/>



    <SolidColorBrush x:Key="HeadCrossWind.LabelBackgroundColor.Inactive" Color="{StaticResource Bg_Gray_Light}"/>
    <SolidColorBrush x:Key="HeadCrossWind.LabelTextColor.Inactive" Color="{StaticResource Bg_Gray_Dark1}"/>
    <SolidColorBrush x:Key="HeadCrossWind.ValueTextBackgroundColor.Inactive" Color="{StaticResource White_Main}"/>
    <SolidColorBrush x:Key="HeadCrossWind.ValueTextColor.Inactive" Color="{StaticResource Bg_Gray_Dark1}"/>

   
    <SolidColorBrush x:Key="HeadCrossWind.LabelBackgroundColor.Active" Color="{StaticResource Blue_Lighter2}"/>
    <SolidColorBrush x:Key="HeadCrossWind.LabelTextColor.Active" Color="{StaticResource Blue_Alt3}"/>
    <SolidColorBrush x:Key="HeadCrossWind.ValueTextBackgroundColor.Active" Color="{StaticResource White_Main}"/>
    <SolidColorBrush x:Key="HeadCrossWind.ValueTextColor.Active" Color="{StaticResource Text_Dark}"/>

    <!--QnhLight Metar-->
    <SolidColorBrush x:Key="QnhLight.ContainerBackgroundColor" Color="{StaticResource White_Main}"/>
    <SolidColorBrush x:Key="QnhLight.LabelBackgroundColor" Color="{StaticResource Blue_Lighter2}"/>
    <SolidColorBrush x:Key="QnhLight.LabelTextColor" Color="{StaticResource Blue_Alt3}"/>
    <SolidColorBrush x:Key="QnhLight.ValueTextBackgroundColor" Color="Transparent"/>
    <SolidColorBrush x:Key="QnhLight.ValueTextColor" Color="{StaticResource Text_Dark}"/>








    <!--侧栏 包括整个 主界面-->
    <SolidColorBrush x:Key="MainBarBg"   Color="{StaticResource Blue_Mid}"/>
    <!--RunwayStatus-->
    <SolidColorBrush x:Key="RwyStatusBg"   Color="{StaticResource Bg_Gray_Lighter}"/>
    <SolidColorBrush x:Key="RwyStatusTextBg.Active"   Color="{StaticResource Blue_Mid}"/>
    <SolidColorBrush x:Key="RwyStatusTextColor.Active"   Color="White"/>
    <SolidColorBrush x:Key="RwyStatusTextBg.Inactive"   Color="#a3aed7"/>
    <SolidColorBrush x:Key="RwyStatusTextColor.Inactive"   Color="#7b83a5"/>





    <SolidColorBrush x:Key="RwyTextColor_InUse"   Color="White"/>
    <SolidColorBrush x:Key="RwyTextColor_NotInUse"   Color="#7b83a5"/>

    <SolidColorBrush x:Key="RwyCapsuleBg_InUse"   Color="#ff5d00"/>
    <SolidColorBrush x:Key="RwyCapsuleBg_NotInUse"   Color="#a3aed7"/>


    <!--QNH-->
    <!--<SolidColorBrush x:Key="QnhLabelBg" Color="#b7d9ea"/>
    <SolidColorBrush x:Key="QnhLabelTextColor" Color="#265bc6"/>
    <SolidColorBrush x:Key="QnhNumberBg" Color="White"/>
    <SolidColorBrush x:Key="QnhNumberTextColor" Color="Black"/>-->
    <!--METAR-->
    <SolidColorBrush x:Key="MeterLabelColor" Color="#265bc6"/>
    <SolidColorBrush x:Key="MeterContentColor" Color="Black"/>




    <!--RvrVis-->
    <SolidColorBrush x:Key="RvrVisLabelBg" Color="#FFDBDFE9"/>
    <SolidColorBrush x:Key="RvrVisTextColor" Color="#7b83a5"/>

    <SolidColorBrush x:Key="LabelBg.Active" Color="#b7d9ea"/>
    <SolidColorBrush x:Key="LabelTextColor.Active" Color="#265bc6"/>

    <SolidColorBrush x:Key="LabelBg.Inactive" Color="#FFDBDFE9"/>
    <SolidColorBrush x:Key="LabelTextColor.Inactive" Color="#7b83a5"/>

    <!--HeadCrossWind-->
    <SolidColorBrush x:Key="HeadCrossWindLableBg.Active" Color="#b7d9ea"/>
    <SolidColorBrush x:Key="HeadCrossWindLableBg.Inactive" Color="#FFDBDFE9"/>
    <SolidColorBrush x:Key="HeadCrossWindLabelTextColor.Active" Color="#265bc6"/>
    <SolidColorBrush x:Key="HeadCrossWindLabelTextColor.Inactive" Color="#7b83a5"/>
    <SolidColorBrush x:Key="HeadCrossWindNumberTextColor.Active" Color="#265bc6"/>
    <SolidColorBrush x:Key="HeadCrossWindNumberTextColor.Inactive" Color="#7b83a5"/>



    <!-- ===== 字体颜色 ===== -->
    <SolidColorBrush x:Key="PrimaryFontBrush"   Color="#1A1A1A"/>
    <!-- 主文字：深黑灰 -->
    <SolidColorBrush x:Key="SecondaryFontBrush" Color="#4A4A4A"/>
    <!-- 次文字：中灰 -->
    <SolidColorBrush x:Key="TertiaryFontBrush"  Color="#7A7A7A"/>
    <!-- 弱提示灰 -->
    <SolidColorBrush x:Key="DisabledFontBrush"  Color="#B5B5B5"/>

    <!-- ===== 背景色 ===== -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#F2F6FA"/>
    <!--<SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="Blue"/>-->
    <!-- 整体亮灰 -->
    <SolidColorBrush x:Key="CardBackgroundBrush"    Color="#FFFFFF"/>
    <!-- 白色 panel -->
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#E5EBF2"/>

    <!-- ===== 分割 / 边线 ===== -->
    <SolidColorBrush x:Key="BorderBrush"  Color="#C9D4E0"/>
    <!-- 边界 -->
    <SolidColorBrush x:Key="DividerBrush" Color="#DDE4ED"/>
    <!-- 分隔线 -->

    <!-- ===== 强调色 ===== -->
    <SolidColorBrush x:Key="AccentBrush"   Color="#296FD8"/>
    <!-- 蓝色高亮按钮 -->
    <SolidColorBrush x:Key="WarningBrush"  Color="#FF8A38"/>
    <!-- 橙色 Landing/Takeoff -->
    <SolidColorBrush x:Key="HighlightBrush" Color="#5297FF"/>




</ResourceDictionary>